{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "falxter-co-jp",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "keep_vars": true,
  "observability": {
    "enabled": true
  }
}
