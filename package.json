{
  "name": "falxter-corporate-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "dev:docker": "astro dev --host 0.0.0.0 --ignore-lock",
    "build": "astro build",
    "start": "astro preview --host 0.0.0.0 --port 4321",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy",
    "types:cloudflare": "wrangler types",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && astro check",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.7",
    "@astrojs/sitemap": "3.7.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.1.3",
    "aws4fetch": "1.0.20",
    "tailwindcss": "4.3.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@biomejs/biome": "2.3.13",
    "@playwright/test": "1.61.1",
    "@types/node": "24.10.10",
    "typescript": "5.9.3",
    "wrangler": "4.115.0"
  }
}
