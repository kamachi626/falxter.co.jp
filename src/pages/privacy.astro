---
import { company } from "../data/company";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/privacy.css";

const description =
  "FALXTER株式会社が取得する個人情報、利用目的、Google Analytics、Cloudflare Turnstile、安全管理措置および開示等の請求について定めるプライバシーポリシーです。";
const policySections = [
  ["basic-policy", "基本方針"],
  ["information", "取得する情報"],
  ["purpose", "利用目的"],
  ["third-party", "第三者提供"],
  ["outsourcing", "業務委託"],
  ["analytics", "Google Analyticsについて"],
  ["turnstile", "Cloudflare Turnstileについて"],
  ["security", "安全管理措置"],
  ["retention", "保管期間"],
  ["disclosure", "開示、訂正、利用停止等"],
  ["changes", "プライバシーポリシーの変更"],
  ["contact-window", "お問い合わせ窓口"],
] as const;
---

<BaseLayout
  title="プライバシーポリシー｜FALXTER株式会社"
  description={description}
  breadcrumbs={[{ name: "トップ", url: "/" }, { name: "プライバシーポリシー", url: "/privacy/" }]}
>
  <header class="page-head privacy-hero">
    <div class="container">
      <p class="breadcrumbs"><a href="/">トップ</a> / プライバシーポリシー</p>
      <p class="eyebrow">Privacy policy</p>
      <h1 class="heading">プライバシーポリシー</h1>
      <p class="lead privacy-lead">
        当社が取得する情報、その利用目的および安全管理措置など、個人情報の取扱いについて定めています。
      </p>
    </div>
  </header>

  <div class="section privacy-section">
    <div class="container privacy-layout">
      <nav class="policy-toc" aria-label="プライバシーポリシー目次">
        <p class="eyebrow">Contents</p>
        <ol>
          {policySections.map(([id, title], index) => <li><a href={`#${id}`}><span>{String(index + 1).padStart(2, "0")}</span>{title}</a></li>)}
        </ol>
      </nav>

      <article class="privacy-content">
        <section id="basic-policy" class="policy-section" aria-labelledby="basic-policy-heading">
          <h2 id="basic-policy-heading"><span>01</span>基本方針</h2>
          <p>
            FALXTER株式会社（以下「当社」といいます。）は、当社が運営するウェブサイトおよび当社が提供するサービスにおいて取得する個人情報を適切に取り扱うため、個人情報の保護に関する法律その他の関係法令を遵守し、以下のとおりプライバシーポリシーを定めます。
          </p>
        </section>

        <section id="information" class="policy-section" aria-labelledby="information-heading">
          <h2 id="information-heading"><span>02</span>取得する情報</h2>
          <p>当社は、次の情報を取得することがあります。</p>
          <ol class="policy-detail-list">
            <li>
              <h3>お問い合わせフォームに入力された情報</h3>
              <p>会社名・屋号、氏名、メールアドレス、電話番号、ご相談の種類、希望時期、ご相談内容その他フォームに入力された情報</p>
            </li>
            <li>
              <h3>ご契約およびサービス提供に必要な情報</h3>
              <p>契約者情報、担当者情報、請求・支払に関する情報、業務上提供された資料および連絡内容</p>
            </li>
            <li>
              <h3>ウェブサイトの利用に関する情報</h3>
              <p>Cookie等の識別子、閲覧したページ、アクセス日時、参照元、ブラウザ・端末・OSに関する情報、おおよその地域情報その他のアクセス情報</p>
            </li>
            <li>
              <h3>不正利用防止に必要な情報</h3>
              <p>自動送信や不正アクセスの判定に必要なブラウザ・端末環境、通信情報、検証結果その他の情報</p>
            </li>
          </ol>
        </section>

        <section id="purpose" class="policy-section" aria-labelledby="purpose-heading">
          <h2 id="purpose-heading"><span>03</span>利用目的</h2>
          <p>当社は、取得した情報を次の目的で利用します。</p>
          <ol class="numbered-list">
            <li>お問い合わせへの回答および連絡</li>
            <li>ご相談内容の確認、提案、見積もりおよび契約手続</li>
            <li>契約した業務およびサービスの提供</li>
            <li>請求、支払および契約管理</li>
            <li>本人確認ならびに不正送信、不正アクセスおよび迷惑行為の防止</li>
            <li>ウェブサイトおよびサービスの利用状況の分析、改善および品質向上</li>
            <li>障害、不具合およびセキュリティ上の問題への対応</li>
            <li>法令上の義務への対応および当社の権利の保護</li>
            <li>上記の利用目的に付随する業務</li>
          </ol>
        </section>

        <section id="third-party" class="policy-section" aria-labelledby="third-party-heading">
          <h2 id="third-party-heading"><span>04</span>第三者提供</h2>
          <p>当社は、次の場合を除き、本人の同意なく個人データを第三者へ提供しません。</p>
          <ol class="numbered-list">
            <li>法令に基づく場合</li>
            <li>人の生命、身体または財産の保護のために必要であり、本人の同意を得ることが困難な場合</li>
            <li>公衆衛生の向上または児童の健全な育成のために特に必要であり、本人の同意を得ることが困難な場合</li>
            <li>国または地方公共団体等が法令に定める事務を遂行することに協力する必要がある場合</li>
            <li>利用目的の達成に必要な範囲で、個人情報の取扱いを委託する場合</li>
            <li>事業の承継に伴って個人情報が提供される場合</li>
          </ol>
        </section>

        <section id="outsourcing" class="policy-section" aria-labelledby="outsourcing-heading">
          <h2 id="outsourcing-heading"><span>05</span>業務委託</h2>
          <p>
            当社は、利用目的の達成に必要な範囲で、サーバー運用、メール送信、データ保管、アクセス解析、不正利用防止その他の業務を外部事業者へ委託することがあります。
          </p>
          <p>この場合、委託先を適切に選定し、必要な契約および監督を行います。</p>
        </section>

        <section id="analytics" class="policy-section" aria-labelledby="analytics-heading">
          <h2 id="analytics-heading"><span>06</span>Google Analyticsについて</h2>
          <p>
            当社ウェブサイトでは、利用状況の把握および改善のため、Google LLCが提供するGoogle Analyticsを利用することがあります。
          </p>
          <p>
            Google Analyticsでは、Cookie等を使用して、閲覧ページ、アクセス日時、セッション情報、ブラウザ・端末情報、おおよその地域情報等が収集されることがあります。Google Analytics 4では、<code>_ga</code> Cookieが利用者およびセッションの識別に使用されます。
          </p>
          <p>
            これらの情報はGoogleの規約およびプライバシーポリシーに基づいて取り扱われます。利用者は、ブラウザの設定によるCookieの無効化またはGoogleが提供するGoogle Analyticsオプトアウトアドオンにより、情報収集を制限できます。
          </p>
          <ul class="reference-links">
            <li><a href="https://policies.google.com/technologies/partner-sites?hl=ja" target="_blank" rel="noopener noreferrer">Googleによる情報の使用</a></li>
            <li><a href="https://tools.google.com/dlpage/gaoptout?hl=ja" target="_blank" rel="noopener noreferrer">Google Analyticsオプトアウトアドオン</a></li>
          </ul>
        </section>

        <section id="turnstile" class="policy-section" aria-labelledby="turnstile-heading">
          <h2 id="turnstile-heading"><span>07</span>Cloudflare Turnstileについて</h2>
          <p>
            当社ウェブサイトでは、お問い合わせフォーム等への自動送信および不正利用を防止するため、Cloudflare, Inc.が提供するCloudflare Turnstileを利用することがあります。
          </p>
          <p>
            Turnstileは、ブラウザ・端末環境等に関する情報を用いてアクセスを判定し、検証結果を示すトークンを生成します。当社は、そのトークンをサーバー側で検証したうえで、フォーム送信を受け付けます。
          </p>
          <p>Turnstileにより取得される情報は、Cloudflareの規約およびTurnstile Privacy Addendumに基づいて取り扱われます。</p>
          <ul class="reference-links">
            <li><a href="https://www.cloudflare.com/turnstile-privacy-policy/" target="_blank" rel="noopener noreferrer">Cloudflare Turnstile Privacy Addendum</a></li>
          </ul>
        </section>

        <section id="security" class="policy-section" aria-labelledby="security-heading">
          <h2 id="security-heading"><span>08</span>安全管理措置</h2>
          <p>
            当社は、個人情報の漏えい、滅失、毀損、不正アクセスその他の事故を防止するため、個人情報を取り扱う者および範囲の限定、アクセス権限の管理、通信の暗号化、入力内容の検証、不正送信対策その他の必要かつ適切な安全管理措置を講じます。
          </p>
          <p>
            また、個人情報を取り扱う委託先について、必要かつ適切な監督を行います。安全管理措置の具体的な内容については、本人からの求めに応じて、法令上回答できる範囲で遅滞なく回答します。
          </p>
        </section>

        <section id="retention" class="policy-section" aria-labelledby="retention-heading">
          <h2 id="retention-heading"><span>09</span>保管期間</h2>
          <p>
            当社は、取得した個人情報を利用目的の達成に必要な期間保管し、保管の必要がなくなった情報は適切な方法で削除または廃棄します。
          </p>
          <p>ただし、法令上の保存義務がある情報、契約や取引の記録として保存する必要がある情報については、必要な期間保管します。</p>
        </section>

        <section id="disclosure" class="policy-section" aria-labelledby="disclosure-heading">
          <h2 id="disclosure-heading"><span>10</span>開示、訂正、利用停止等</h2>
          <p>
            本人は、当社が保有する本人の個人データについて、利用目的の通知、開示、訂正、追加、削除、利用停止、消去または第三者提供の停止を請求できます。
          </p>
          <p>請求を受けた場合は、本人確認を行ったうえで、個人情報保護法その他の関係法令に基づき対応します。</p>
          <p>請求方法については、下記のお問い合わせ窓口までご連絡ください。</p>
        </section>

        <section id="changes" class="policy-section" aria-labelledby="changes-heading">
          <h2 id="changes-heading"><span>11</span>プライバシーポリシーの変更</h2>
          <p>当社は、法令の改正、サービス内容の変更その他必要に応じて、本プライバシーポリシーを変更することがあります。</p>
          <p>変更後のプライバシーポリシーは、当社ウェブサイトに掲載した時点から効力を生じます。</p>
        </section>

        <section id="contact-window" class="policy-section contact-window" aria-labelledby="contact-window-heading">
          <h2 id="contact-window-heading"><span>12</span>お問い合わせ窓口</h2>
          <p>個人情報の取扱いに関するお問い合わせは、以下までご連絡ください。</p>
          <address>
            <strong>{company.companyName}</strong><br />
            {company.representativeTitle?.split("／")[0]}　{company.representativeName}<br />
            {company.postalCode}<br />
            {company.address}<br />
            電話番号：{company.phone ? <a href={`tel:${company.phone.replaceAll("-", "")}`}>{company.phone}</a> : "未設定"}<br />
            メールアドレス：{company.email ? <a href={`mailto:${company.email}`}>{company.email}</a> : "未設定"}
          </address>
          <p class="enacted-date">制定日：2026年7月31日</p>
        </section>
      </article>
    </div>
  </div>
</BaseLayout>