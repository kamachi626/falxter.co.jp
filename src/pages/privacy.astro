---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
---
<BaseLayout title="プライバシーポリシー | FALXTER株式会社" description="FALXTER株式会社のプライバシーポリシー（ダミー）。">
	<PageHeader title="プライバシーポリシー" description="本ページはダミーのプライバシーポリシーです。実際の運用に合わせて調整してください。" badge="Privacy" />
	<Section>
		<div class="prose max-w-4xl text-gray-800">
			<h2>個人情報の取り扱い</h2>
			<p>お問い合わせや業務遂行に必要な範囲でのみ個人情報を利用し、適切に管理します。</p>
			<h2>利用目的</h2>
			<ul>
				<li>お問い合わせ内容への回答</li>
				<li>契約履行に必要な連絡</li>
				<li>サービス改善のための分析</li>
			</ul>
			<h2>お問い合わせ窓口</h2>
			<p>info@falxter.co.jp までご連絡ください。</p>
			<p class="text-sm text-gray-600">※ 実運用前に法務確認の上、適切に修正してください。</p>
		</div>
	</Section>
</BaseLayout>
