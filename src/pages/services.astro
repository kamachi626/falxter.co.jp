---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import PageHeader from '../components/PageHeader.astro'
import Section from '../components/Section.astro'
import Button from '../components/Button.astro'
import { services } from '../data/services'
---
<BaseLayout title="サービス紹介 | FALXTER株式会社" description="業務システム・Webアプリ・EC・サイト制作まで、小回りの利く体制で支援します。" url="https://falxter.co.jp/services">
	<Header slot="header" />
	<PageHeader
		title="サービス紹介"
		description="業務システム開発からWebアプリケーション、EC構築、Webサイト制作まで。規模に合わせて柔軟にチーム編成します。"
		breadcrumb={[{ label: 'ホーム', href: '/' }, { label: 'サービス', href: '/services' }]}
	/>
	<Section subtitle="Services" title="提供メニュー">
		<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
			{services.map((service) => (
				<article class="card-base space-y-3">
					<h2 class="text-lg font-semibold text-gray-900">{service.title}</h2>
					<p class="text-sm text-gray-700">{service.description}</p>
					<p class="text-xs font-semibold text-gray-500">想定クライアント</p>
					<p class="text-sm text-gray-700">{service.clients}</p>
					<p class="text-xs font-semibold text-gray-500">使用技術</p>
					<div class="flex flex-wrap gap-2">
						{service.tech.map((tech) => (
							<span class="rounded-full bg-gray-100 px-3 py-1 text-xs text-gray-700">{tech}</span>
						))}
					</div>
				</article>
			))}
		</div>
		<div class="mt-8 text-center">
			<Button label="お問い合わせ" href="/contact" />
		</div>
	</Section>
	<Footer slot="footer" />
</BaseLayout>
