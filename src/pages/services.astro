---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { services } from '../data/services';
---
<BaseLayout title="サービス紹介 | FALXTER株式会社" description="業務システム開発、Webアプリケーション、ECサイト構築、Webサイト制作を提供しています。">
        <PageHeader title="サービス紹介" subtitle="業務システムからWebアプリ、ECサイトまで柔軟に支援します。" />
        <section class="mx-auto max-w-5xl px-4 pt-8 md:px-6 md:pt-12">
                <figure class="overflow-hidden rounded-2xl border border-gray-200 shadow-sm">
                        <img
                                src="https://images.unsplash.com/photo-1520607162513-77705c0f0d4a?auto=format&fit=crop&w=1200&q=80"
                                alt="ホワイトボードで要件と画面設計を共有する開発チーム"
                                class="h-72 w-full object-cover"
                                loading="lazy"
                        />
                </figure>
        </section>
        <Section title="提供サービス一覧" description="想定クライアント、開発内容、使用技術の例をまとめています。">
                <div class="grid gap-6 md:grid-cols-2">
                        {services.map((service) => (
				<article class="h-full rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
					<div class="flex items-start justify-between gap-3">
						<h2 class="text-xl font-semibold text-gray-900">{service.title}</h2>
						<span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">{service.clients}</span>
					</div>
					<p class="mt-3 text-sm text-gray-700">{service.description}</p>
					<div class="mt-4 space-y-2 text-xs text-gray-700">
						<p class="font-semibold text-gray-800">想定クライアント</p>
						<p class="rounded bg-gray-50 px-3 py-2">{service.clients}</p>
						<p class="pt-2 font-semibold text-gray-800">開発内容の例</p>
						<ul class="space-y-1">
							{service.features.map((feature) => (
								<li class="flex gap-2"><span class="mt-1 h-1.5 w-1.5 rounded-full bg-primary"></span>{feature}</li>
							))}
						</ul>
						<p class="pt-2 font-semibold text-gray-800">使用技術例</p>
						<p class="rounded bg-gray-50 px-3 py-2">{service.technologies.join(', ')}</p>
					</div>
				</article>
			))}
		</div>
	</Section>
</BaseLayout>
