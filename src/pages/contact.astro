---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import PageHeader from '../components/PageHeader.astro'
import Section from '../components/Section.astro'
import Button from '../components/Button.astro'
---
<BaseLayout title="お問い合わせ | FALXTER株式会社" description="お問い合わせフォーム。プロジェクトのご相談やご質問を受け付けています。" url="https://falxter.co.jp/contact">
	<Header slot="header" />
	<PageHeader
		title="お問い合わせ"
		description="お気軽にご相談ください。折り返し担当者よりご連絡いたします。"
		breadcrumb={[{ label: 'ホーム', href: '/' }, { label: 'お問い合わせ', href: '/contact' }]}
	/>
	<Section subtitle="Contact" title="フォーム">
		<div class="grid gap-8 md:grid-cols-2">
			<form class="card-base space-y-4" id="contact-form" novalidate>
				<div>
					<label class="block text-sm font-semibold text-gray-700" for="name">お名前</label>
					<input id="name" name="name" type="text" required aria-required="true" />
				</div>
				<div>
					<label class="block text-sm font-semibold text-gray-700" for="email">メールアドレス</label>
					<input id="email" name="email" type="email" required aria-required="true" />
				</div>
				<div>
					<label class="block text-sm font-semibold text-gray-700" for="message">お問い合わせ内容</label>
					<textarea id="message" name="message" rows="5" required aria-required="true"></textarea>
				</div>
				<div class="flex items-center gap-3">
					<Button label="送信する" type="submit" />
					<p class="text-sm text-gray-500" id="form-status" role="status"></p>
				</div>
			</form>
			<div class="card-base space-y-3 text-sm text-gray-700">
				<h2 class="text-lg font-semibold text-gray-900">ご連絡先</h2>
				<p>メール: info@falxter.co.jp</p>
				<p>対応時間: 平日 10:00-18:00（日本時間）</p>
				<p>入力内容は送信後に担当者から折り返します。機密情報は記載しないようお願いいたします。</p>
			</div>
		</div>
	</Section>
	<Footer slot="footer" />
</BaseLayout>
<script>
	const form = document.getElementById('contact-form') as HTMLFormElement | null
	const statusEl = document.getElementById('form-status')
	form?.addEventListener('submit', (event) => {
		event.preventDefault()
		if (!form.checkValidity()) {
			statusEl?.classList.remove('text-green-700')
			statusEl?.classList.add('text-red-600')
			statusEl && (statusEl.textContent = '未入力の項目があります。確認してください。')
			return
		}
		const email = (form.querySelector('#email') as HTMLInputElement | null)?.value ?? ''
		const emailValid = /.+@.+\..+/.test(email)
		if (!emailValid) {
			statusEl?.classList.remove('text-green-700')
			statusEl?.classList.add('text-red-600')
			statusEl && (statusEl.textContent = 'メールアドレスの形式が正しくありません。')
			return
		}
		statusEl?.classList.remove('text-red-600')
		statusEl?.classList.add('text-green-700')
		statusEl && (statusEl.textContent = '送信しました。担当者よりご連絡いたします。')
		form.reset()
	})
</script>
