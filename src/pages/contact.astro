---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { siteConfig } from '../site.config';

const meta = {
  title: '問い合わせ | FALXTER株式会社',
  description: '制作・開発・保守のご相談はこちらから。2営業日以内の返信を心がけています。'
};

const inquiryTypes = ['見積', '相談', '協業', 'その他'];
---
<BaseLayout title={meta.title} description={meta.description} path="/contact">
  <section class="bg-gray-50 py-14">
    <div class="container-responsive space-y-10">
      <SectionHeading
        title="お問い合わせ"
        description="2営業日以内の返信を心がけています。営業目的のご連絡には返信しない場合があります。"
      />
      <div class="grid gap-8 md:grid-cols-2">
        <div class="space-y-4 text-sm text-gray-800">
          <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-semibold text-gray-900">ご連絡先</h2>
            <p class="mt-2">メール: <a href={`mailto:${siteConfig.email}`} class="font-semibold text-brand">{siteConfig.email}</a></p>
            <p>電話: <a href={`tel:${siteConfig.phone.replace(/-/g, '')}`} class="font-semibold text-brand">{siteConfig.phone}</a></p>
            <p class="mt-3 text-sm text-gray-700">返信目安: 2営業日以内</p>
          </div>
          <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <h3 class="text-sm font-semibold text-gray-900">運用について</h3>
            <ul class="mt-2 space-y-2 text-sm text-gray-700">
              <li>フォーム送信先はWeb3Formsを利用しています。自前実装に差し替え可能です。</li>
              <li>送信後は /contact/thanks にリダイレクトします。</li>
              <li>営業目的の連絡は返信しない場合があります。</li>
            </ul>
          </div>
        </div>

        <form
          class="space-y-4 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm"
          action="https://api.web3forms.com/submit"
          method="POST"
        >
          <input type="hidden" name="access_key" value="TODO_WEB3FORMS_ACCESS_KEY" />
          <input type="hidden" name="subject" value="FALXTER.co.jp お問い合わせ" />
          <input type="hidden" name="redirect" value="https://falxter.co.jp/contact/thanks" />
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div>
            <label for="type" class="mb-1 block text-sm font-semibold text-gray-800">種別</label>
            <select
              id="type"
              name="種別"
              class="block w-full rounded-lg border border-gray-300 bg-white p-3 text-sm text-gray-900 focus:border-brand focus:ring-brand"
              required
            >
              <option value="" disabled selected>選択してください</option>
              {inquiryTypes.map((type) => (
                <option value={type}>{type}</option>
              ))}
            </select>
          </div>

          <div>
            <label for="company" class="mb-1 block text-sm font-semibold text-gray-800">会社名（任意）</label>
            <input
              id="company"
              name="会社名"
              type="text"
              class="block w-full rounded-lg border border-gray-300 p-3 text-sm text-gray-900 focus:border-brand focus:ring-brand"
              placeholder="例: 株式会社○○"
            />
          </div>

          <div>
            <label for="name" class="mb-1 block text-sm font-semibold text-gray-800">氏名 *</label>
            <input
              id="name"
              name="氏名"
              type="text"
              required
              class="block w-full rounded-lg border border-gray-300 p-3 text-sm text-gray-900 focus:border-brand focus:ring-brand"
            />
          </div>

          <div>
            <label for="email" class="mb-1 block text-sm font-semibold text-gray-800">メール *</label>
            <input
              id="email"
              name="メール"
              type="email"
              required
              class="block w-full rounded-lg border border-gray-300 p-3 text-sm text-gray-900 focus:border-brand focus:ring-brand"
              placeholder="customer@example.com"
            />
          </div>

          <div>
            <label for="message" class="mb-1 block text-sm font-semibold text-gray-800">本文 *</label>
            <textarea
              id="message"
              name="本文"
              rows="6"
              required
              class="block w-full rounded-lg border border-gray-300 p-3 text-sm text-gray-900 focus:border-brand focus:ring-brand"
              placeholder="ご相談内容や背景をお聞かせください"
            ></textarea>
          </div>

          <p class="text-xs text-gray-600">※ 営業目的のご連絡は返信しない場合があります。</p>

          <button
            type="submit"
            class="inline-flex w-full items-center justify-center rounded-lg bg-brand px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand/90 focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2"
          >
            送信する
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
