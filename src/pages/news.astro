---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { newsList } from '../data/news';
---
<BaseLayout title="お知らせ | FALXTER株式会社" description="FALXTER株式会社のお知らせ、技術ブログ、メンテナンス情報です。">
	<PageHeader title="お知らせ一覧" subtitle="日付降順で最新情報を掲載しています。" />
	<section class="mx-auto max-w-5xl px-4 py-12 md:px-6 md:py-16">
		<div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
			{newsList.sort((a, b) => b.date.localeCompare(a.date)).map((news) => (
				<a class="flex items-start gap-4 px-5 py-4 transition hover:bg-gray-50" href={`/news/${news.slug}`}>
					<div class="text-xs font-semibold text-primary">{news.category}</div>
					<div class="flex-1">
						<p class="text-xs text-gray-600">{news.date}</p>
						<p class="text-sm font-semibold text-gray-900">{news.title}</p>
						<p class="text-xs text-gray-700">{news.description}</p>
					</div>
				</a>
			))}
		</div>
	</section>
</BaseLayout>
