---
export const prerender = true;

import { company } from "../../data/company";
import { services } from "../../data/services";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service } = Astro.props;
const isCorporateWebsite = service.slug === "corporate-website";
const defaultSections = [
  { title: "対象となるお客様", items: service.audience },
  { title: "よくある課題", items: service.challenges },
  { title: "主な対応内容", items: service.work },
  { title: "標準範囲・対象技術", items: service.scope },
  { title: "成果物", items: service.deliverables },
  { title: "進行方法", items: service.process },
  { title: "標準範囲外・対応できない範囲", items: service.exclusions },
];
const sections = service.detailSections ?? defaultSections;
---
<BaseLayout title={service.seoTitle} description={service.seoDescription} breadcrumbs={[{ name: "トップ", url: "/" }, { name: "サービス", url: "/services/" }, { name: service.title, url: `/services/${service.slug}/` }]}>
  <header class="page-head">
    <div class="container">
      <p class="breadcrumbs"><a href="/">トップ</a> / <a href="/services/">サービス</a> / {service.title}</p>
      <p class="eyebrow">Service</p>
      <h1 class="heading">{service.title}</h1>
      <p class="lead">{service.summary}</p>
    </div>
  </header>
  <div class="section narrow prose">
    {isCorporateWebsite && service.plans && (
      <section class="plan-comparison" aria-labelledby="plan-comparison-heading">
        <h2 id="plan-comparison-heading">2つの固定料金プラン</h2>
        <p>掲載情報が少なく会社や事業の概要を1ページにまとめたい場合は1ページプラン、サービスや会社情報を複数ページに分けたい場合は最大5ページプランが適しています。</p>
        <div class="plan-grid">
          {service.plans.map((plan) => (
            <article class="plan-card">
              <p class="plan-label">{plan.shortName}</p>
              <h3>{plan.name}</h3>
              <p class="plan-price">{plan.price}</p>
              <dl>
                <div><dt>ページ数</dt><dd>{plan.pageCount}</dd></div>
                <div><dt>構成</dt><dd>{plan.structure}</dd></div>
                <div><dt>制作期間</dt><dd>{plan.duration}</dd></div>
                <div><dt>デザイン</dt><dd>{plan.design}</dd></div>
                <div><dt>修正</dt><dd>{plan.revision}</dd></div>
                <div><dt>適した用途</dt><dd>{plan.audience}</dd></div>
              </dl>
            </article>
          ))}
        </div>
        {service.priceNote && <p class="product-note">{service.priceNote}</p>}
      </section>
    )}
    {sections.map((section) => (
      <section>
        <h2>{section.title}</h2>
        {"intro" in section && section.intro && <p>{section.intro}</p>}
        <ul>{section.items.map((item) => <li>{item}</li>)}</ul>
      </section>
    ))}
    {!isCorporateWebsite && service.notice && <p class="notice">{service.notice}</p>}
    {!isCorporateWebsite && (
      <section>
        <h2>期間目安</h2>
        <p>{service.duration}</p>
      </section>
    )}
    {!isCorporateWebsite && company.flags.showPricing && (
      <section>
        <h2>料金の目安</h2>
        <p>{service.price}</p>
        <p>対象範囲と前提を確認後、正式にお見積もりします。</p>
      </section>
    )}
    <section>
      <h2>よくある質問</h2>
      {service.faqs.map((faq) => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}
    </section>
    <aside class="cta">
      <h2>{isCorporateWebsite ? "Webサイト制作について相談する" : "状況を整理するところから、ご相談ください。"}</h2>
      {isCorporateWebsite && <p>掲載したい内容が1ページに収まるか分からない場合も、内容を確認して適したプランをご案内します。</p>}
      <a class="button" href={`/contact/?service=${service.contactService}`}>{isCorporateWebsite ? "Webサイト制作について相談する" : "システムについて相談する"}</a>
    </aside>
  </div>
</BaseLayout>
<style>
  details{border-top:1px solid var(--color-border);padding:1rem 0}summary{font-weight:700;cursor:pointer}.notice{border-left:4px solid var(--color-accent);padding:1rem;background:#efebe5}.plan-comparison{margin-top:0}.plan-comparison>p{max-width:48rem}.plan-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin:1.5rem 0}.plan-card{min-width:0;padding:clamp(1.35rem,3vw,2rem);border:1px solid var(--color-border);border-top:4px solid var(--color-primary);background:#fbfaf8}.plan-label{margin:0 0 .35rem!important;color:var(--color-primary);font-size:.875rem;font-weight:800;letter-spacing:.04em}.plan-card h3{margin:.25rem 0 .65rem;font-size:clamp(1.3rem,2vw,1.55rem)}.plan-price{margin:0 0 1rem!important;color:var(--color-text);font-size:1.25rem;font-weight:800}.plan-card dl{margin:0}.plan-card dl div{display:grid;grid-template-columns:5.25rem minmax(0,1fr);gap:.75rem;padding:.7rem 0;border-top:1px solid var(--color-border)}.plan-card dt{color:var(--color-primary);font-size:.875rem;font-weight:800}.plan-card dd{margin:0;color:var(--color-body);font-size:1rem;line-height:1.7}.product-note{margin:1rem 0 0;color:var(--color-body);font-size:1rem;line-height:1.8}.cta{margin-top:4rem;padding:2rem;background:#efebe5}.cta h2{margin-top:0}.cta p{max-width:42rem}@media(max-width:720px){.plan-grid{grid-template-columns:1fr}}@media(max-width:420px){.plan-card dl div{grid-template-columns:1fr;gap:.15rem}}
</style>