---
import {
  websiteExternalCostNote,
  websiteFeatures,
  websiteLegalDisclaimer,
  websitePageCountNote,
  websitePlanExamples,
  websitePricingExclusions,
  websitePrivacyPolicyNote,
  websiteProcess,
  websiteResponsibilities,
} from "../../data/corporateWebsite";
import { services, sharedWebsiteInclusions } from "../../data/services";
import BaseLayout from "../../layouts/BaseLayout.astro";

const service = services.find((item) => item.slug === "corporate-website");
if (!service || !service.plans) {
  throw new Error("コーポレートサイト制作のサービスデータが見つかりません。");
}

const contactHref = "/contact/?service=website-consultation";
const serviceUrl = new URL("/services/corporate-website/", Astro.site).toString();
const offerDetails = {
  "one-page": {
    price: 150000,
    description: "15万円（税別）、1ページ・8セクションまで、制作期間3〜4週間",
  },
  "five-page": {
    price: 300000,
    description: "30万円（税別）、最大5ページ、制作期間4〜6週間",
  },
} as const;

const serviceStructuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  serviceType: "中小企業向けコーポレートサイト制作",
  description: service.seoDescription,
  url: serviceUrl,
  provider: {
    "@type": "Organization",
    name: "FALXTER株式会社",
    url: new URL("/", Astro.site).toString(),
  },
  offers: service.plans.map((plan) => {
    const details = offerDetails[plan.id];
    return {
      "@type": "Offer",
      name: plan.name,
      url: new URL(`#${plan.id}-plan`, serviceUrl).toString(),
      price: details.price,
      priceCurrency: "JPY",
      priceSpecification: {
        "@type": "PriceSpecification",
        price: details.price,
        priceCurrency: "JPY",
        valueAddedTaxIncluded: false,
      },
      description: details.description,
    };
  }),
};
---

<BaseLayout
  title={service.seoTitle}
  description={service.seoDescription}
  breadcrumbs={[
    { name: "トップ", url: "/" },
    { name: "サービス", url: "/services/" },
    { name: service.title, url: "/services/corporate-website/" },
  ]}
>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(serviceStructuredData)}
  />

  <header class="page-head website-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="パンくずリスト">
        <a href="/">トップ</a><span aria-hidden="true">/</span><a href="/services/">サービス</a><span
          aria-hidden="true">/</span
        ><span>{service.title}</span>
      </nav>
      <p class="eyebrow">SERVICE</p>
      <h1 class="heading"><span>中小企業向け</span><span>コーポレートサイト制作</span></h1>
      <p class="website-lead">{service.summary}</p>
      <a class="button secondary website-hero-cta" href={contactHref}>
        Webサイト制作について相談する
      </a>
    </div>
  </header>

  <section class="section plan-section" aria-labelledby="plans-heading">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">PLANS</p>
        <h2 id="plans-heading">2つの固定料金プラン</h2>
        <p>
          掲載情報が少なく会社や事業の概要を1ページにまとめたい場合は1ページプラン、サービスや会社情報を複数ページに分けたい場合は最大5ページプランが適しています。
        </p>
      </div>
      <div class="plan-grid">
        {service.plans.map((plan) => (
          <article id={`${plan.id}-plan`} class="plan-card">
            <p class="plan-label">{plan.shortName}</p>
            <h3>{plan.name}</h3>
            <p class="plan-price">{plan.price}</p>
            <dl>
              <div>
                <dt>制作範囲</dt>
                <dd>{plan.pageCount}{plan.id === "one-page" ? `・${plan.structure}` : ""}</dd>
              </div>
              <div>
                <dt>制作期間</dt>
                <dd>{plan.duration}</dd>
              </div>
              <div>
                <dt>デザイン</dt>
                <dd>{plan.design}</dd>
              </div>
              <div>
                <dt>修正</dt>
                <dd>{plan.revision}</dd>
              </div>
              <div>
                <dt>適した用途</dt>
                <dd>{plan.audience}</dd>
              </div>
            </dl>
          </article>
        ))}
      </div>
      <div class="section-note plan-note">
        {service.priceNote && <p>{service.priceNote}</p>}
        <p>{websitePageCountNote}</p>
      </div>
    </div>
  </section>

  <section class="section surface feature-section" aria-labelledby="features-heading">
    <div class="container">
      <div class="section-heading compact-heading">
        <p class="eyebrow">FEATURES</p>
        <h2 id="features-heading">この制作プランの特徴</h2>
      </div>
      <ol class="feature-list">
        {websiteFeatures.map((feature) => (
          <li>
            <span>{feature.number}</span>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section inclusion-section" aria-labelledby="inclusions-heading">
    <div class="container">
      <div class="section-heading compact-heading">
        <p class="eyebrow">INCLUDED</p>
        <h2 id="inclusions-heading">両プランに共通して含まれる内容</h2>
        <p>
          既存の設計パターンを基に、企業のロゴ、配色、写真、事業内容に合わせて調整します。
        </p>
      </div>
      <ol class="inclusion-list">
        {sharedWebsiteInclusions.map((item, index) => (
          <li><span>{String(index + 1).padStart(2, "0")}</span><p>{item}</p></li>
        ))}
      </ol>
      <p class="section-note seo-note">
        基本SEOでは、ページタイトル、メタディスクリプション、OGP、サイトマップなどの基本設定を行います。検索順位の保証や継続的なSEO施策は含みません。
      </p>
    </div>
  </section>

  <section class="section surface examples-section" aria-labelledby="examples-heading">
    <div class="container">
      <div class="section-heading compact-heading">
        <p class="eyebrow">EXAMPLES</p>
        <h2 id="examples-heading">プランごとの構成例</h2>
      </div>
      <div class="comparison-grid">
        {websitePlanExamples.map((example) => (
          <section class="comparison-panel" aria-labelledby={`${example.id}-heading`}>
            <p class="comparison-label">{example.label}</p>
            <h3 id={`${example.id}-heading`}>{example.title}</h3>
            <ol>
              {example.items.map((item, index) => (
                <li><span>{String(index + 1).padStart(2, "0")}</span>{item}</li>
              ))}
            </ol>
            <p class="comparison-note">{example.note}</p>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="section responsibility-section" aria-labelledby="responsibility-heading">
    <div class="container">
      <div class="section-heading compact-heading">
        <p class="eyebrow">RESPONSIBILITIES</p>
        <h2 id="responsibility-heading">制作に必要な素材と役割分担</h2>
      </div>
      <div class="responsibility-grid">
        {websiteResponsibilities.map((group) => (
          <section>
            <h3>{group.title}</h3>
            <ul class="line-list">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        ))}
      </div>
      <p class="section-note">
        原稿作成、取材、撮影、ロゴ制作は標準料金に含まれません。必要な場合は内容を確認して個別にご案内します。
      </p>
    </div>
  </section>

  <section class="section surface exclusion-section" aria-labelledby="exclusions-heading">
    <div class="container">
      <div class="section-heading compact-heading">
        <p class="eyebrow">OPTIONS</p>
        <h2 id="exclusions-heading">標準料金外・個別見積もりとなる内容</h2>
        <p>プランごとの標準範囲を超える場合は、内容を確認した上で個別にお見積もりします。</p>
      </div>
      <ul class="exclusion-list">
        {websitePricingExclusions.map((item) => <li>{item}</li>)}
      </ul>
      <div class="standard-notes">
        <p>{websiteExternalCostNote}</p>
        <p>{websitePrivacyPolicyNote}</p>
        <p>
          修正は、初稿に対する一括修正1回を標準範囲とします。追加修正は内容を確認して個別にご案内します。
        </p>
      </div>
      <p class="section-note">{websiteLegalDisclaimer}</p>
    </div>
  </section>

  <section class="section process-section" aria-labelledby="process-heading">
    <div class="container">
      <div class="section-heading compact-heading">
        <p class="eyebrow">PROCESS</p>
        <h2 id="process-heading">制作の流れ</h2>
      </div>
      <ol class="website-process">
        {websiteProcess.map((step) => (
          <li>
            <span>{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section surface faq-section" aria-labelledby="faq-heading">
    <div class="container faq-container">
      <div class="section-heading compact-heading">
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-heading">よくある質問</h2>
      </div>
      <div class="website-faq">
        {service.faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section website-cta" aria-labelledby="website-cta-heading">
    <div class="narrow">
      <p class="eyebrow">CONTACT</p>
      <h2 id="website-cta-heading">掲載内容が整理できていなくても、ご相談ください。</h2>
      <p>
        会社や事業の情報量を確認し、1ページまたは最大5ページのどちらが適しているか、必要な構成と進め方をご案内します。
      </p>
      <a class="button" href={contactHref}>Webサイト制作について相談する</a>
    </div>
  </section>
</BaseLayout>

<style>
  .website-hero h1{max-width:66rem;word-break:auto-phrase}.website-lead{max-width:66rem;margin:1.5rem 0 0;color:var(--color-body);font-size:1.125rem;line-height:1.9}.website-hero-cta{margin-top:1.75rem}.surface{background:var(--color-surface)}.section-heading{max-width:60rem;margin-bottom:2rem}.section-heading h2{margin:.55rem 0 0;font-size:clamp(1.8rem,3.5vw,2.65rem);line-height:1.4;word-break:auto-phrase}.section-heading>p:not(.eyebrow){margin:1rem 0 0;color:var(--color-body);font-size:1.0625rem;line-height:1.85}.compact-heading{margin-bottom:2rem}.plan-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem}.plan-card{display:flex;min-width:0;flex-direction:column;padding:clamp(1.5rem,3vw,2.25rem);border:1px solid var(--color-border);border-top:4px solid var(--color-primary);background:#fff}.plan-label,.comparison-label{margin:0 0 .45rem;color:var(--color-primary);font-size:.82rem;font-weight:800;letter-spacing:.06em}.plan-card h3{margin:0;font-size:clamp(1.35rem,2.2vw,1.75rem);line-height:1.45;word-break:auto-phrase}.plan-price{margin:.9rem 0 1.35rem;color:var(--color-text);font-size:1.35rem;font-weight:800;white-space:nowrap}.plan-card dl{margin:0;border-top:1px solid var(--color-border)}.plan-card dl div{display:grid;grid-template-columns:6.25rem minmax(0,1fr);gap:1rem;padding:.85rem 0;border-bottom:1px solid var(--color-border)}.plan-card dt{color:var(--color-primary);font-size:.85rem;font-weight:800}.plan-card dd{margin:0;color:var(--color-body);font-size:1rem;line-height:1.7}.section-note{margin:1.5rem 0 0;padding:1rem 1.15rem;border-left:3px solid var(--color-accent);background:#fff;color:var(--color-body);font-size:1rem;line-height:1.8}.plan-section .section-note,.responsibility-section .section-note{background:var(--color-surface)}.plan-note p,.standard-notes p{margin:0}.plan-note p+p{margin-top:.7rem}.standard-notes{display:grid;gap:.55rem;margin-top:1.5rem}.standard-notes p{color:var(--color-body);font-size:1rem;line-height:1.8}.feature-list,.inclusion-list,.website-process{display:grid;margin:0;padding:0;list-style:none}.feature-list{grid-template-columns:repeat(3,minmax(0,1fr));border-top:3px solid var(--color-primary)}.feature-list li{min-width:0;padding:1.4rem 1.25rem;border-right:1px solid var(--color-border)}.feature-list li:last-child{border-right:0}.feature-list>li>span,.inclusion-list span,.website-process>li>span{color:var(--color-primary);font:800 .78rem/1 ui-monospace,SFMono-Regular,Consolas,monospace;letter-spacing:.1em}.feature-list h3{margin:.9rem 0 .55rem;font-size:1.1rem;line-height:1.55}.feature-list p{margin:0;color:var(--color-body);font-size:1rem;line-height:1.75}.inclusion-list{grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--color-border)}.inclusion-list li{min-width:0;padding:1.2rem 1rem;border-right:1px solid var(--color-border);border-bottom:1px solid var(--color-border)}.inclusion-list li:nth-child(4n){border-right:0}.inclusion-list p{margin:.65rem 0 0;color:var(--color-body);font-size:1rem;font-weight:650;line-height:1.7}.seo-note{max-width:60rem}.comparison-grid,.responsibility-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem}.comparison-panel,.responsibility-grid>section{min-width:0;padding:clamp(1.35rem,3vw,2rem);border:1px solid var(--color-border);background:#fff}.comparison-panel h3,.responsibility-grid h3{margin:.25rem 0 1rem;font-size:clamp(1.2rem,2vw,1.5rem);line-height:1.5}.comparison-panel ol{margin:0;padding:0;border-top:1px solid var(--color-border);list-style:none}.comparison-panel li{display:flex;gap:.8rem;padding:.7rem 0;border-bottom:1px solid var(--color-border);color:var(--color-body);font-size:1rem;line-height:1.7}.comparison-panel li span{flex:none;color:var(--color-primary);font:800 .75rem/1.7 ui-monospace,SFMono-Regular,Consolas,monospace}.comparison-note{margin:1.25rem 0 0;color:var(--color-body);font-size:.95rem;line-height:1.75}.line-list,.exclusion-list{margin:0;padding:0;list-style:none}.line-list{border-top:1px solid var(--color-border)}.line-list li{position:relative;padding:.75rem 0 .75rem 1.1rem;border-bottom:1px solid var(--color-border);color:var(--color-body);font-size:1rem;line-height:1.7}.line-list li::before{position:absolute;top:1.45rem;left:0;width:.45rem;border-top:1px solid var(--color-primary);content:""}.exclusion-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 1.5rem;border-top:1px solid var(--color-border)}.exclusion-list li{padding:.85rem 0;border-bottom:1px solid var(--color-border);color:var(--color-body);font-size:1rem;line-height:1.7}.website-process{grid-template-columns:repeat(3,minmax(0,1fr));border-top:3px solid var(--color-primary)}.website-process li{min-width:0;padding:1.35rem 1.15rem;border-right:1px solid var(--color-border);border-bottom:1px solid var(--color-border)}.website-process li:nth-child(3n){border-right:0}.website-process h3{margin:.8rem 0 .5rem;font-size:1.05rem;line-height:1.55}.website-process p{margin:0;color:var(--color-body);font-size:1rem;line-height:1.75}.faq-container{max-width:68rem}.website-faq{border-top:1px solid var(--color-border)}.website-faq details{border-bottom:1px solid var(--color-border)}.website-faq summary{display:flex;min-height:64px;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 0;color:var(--color-text);font-size:1.0625rem;font-weight:750;line-height:1.6;cursor:pointer;list-style:none}.website-faq summary::-webkit-details-marker{display:none}.website-faq summary::after{flex:none;color:var(--color-primary);content:"＋"}.website-faq details[open] summary::after{content:"−"}.website-faq details p{margin:0;padding:0 2rem 1.25rem 0;color:var(--color-body);font-size:1rem;line-height:1.8}.website-cta{border-top:1px solid var(--color-border);text-align:center}.website-cta h2{margin:.8rem 0 1rem;font-size:clamp(1.8rem,4vw,3rem);line-height:1.45;word-break:auto-phrase}.website-cta p:not(.eyebrow){margin:0 auto 1.75rem;color:var(--color-body);font-size:1.0625rem;line-height:1.85}
  @media(min-width:721px){.plan-card h3{min-height:3.2em}}
  @media(max-width:900px){.inclusion-list{grid-template-columns:repeat(2,minmax(0,1fr))}.inclusion-list li:nth-child(4n){border-right:1px solid var(--color-border)}.inclusion-list li:nth-child(2n){border-right:0}.website-process{grid-template-columns:repeat(2,minmax(0,1fr))}.website-process li:nth-child(3n){border-right:1px solid var(--color-border)}.website-process li:nth-child(2n){border-right:0}}
  @media(max-width:720px){.plan-grid,.comparison-grid,.responsibility-grid,.exclusion-list{grid-template-columns:1fr}.feature-list{grid-template-columns:1fr}.feature-list li,.feature-list li:last-child{border-right:0;border-bottom:1px solid var(--color-border)}.feature-list li:last-child{border-bottom:0}.plan-card dl div{grid-template-columns:1fr;gap:.2rem}}
  @media(max-width:520px){.website-hero h1{font-size:clamp(1.6rem,7.68vw,1.8rem)}.website-hero h1 span{display:block;white-space:nowrap}.inclusion-list,.website-process{grid-template-columns:1fr}.inclusion-list li,.inclusion-list li:nth-child(2n),.inclusion-list li:nth-child(4n),.website-process li,.website-process li:nth-child(2n),.website-process li:nth-child(3n){border-right:0}.website-hero-cta,.website-cta .button{width:100%}}
</style>