---
import { websitePlans } from "../../data/services";
import BaseLayout from "../../layouts/BaseLayout.astro";

const description =
  "既存システムの調査・引き継ぎ・保守・改修、周辺機能や新規システムの開発、中小企業向けコーポレートサイト制作を提供しています。";
const maintenancePrices = [
  { label: "スポット保守・改修", value: "個別見積もり" },
  { label: "継続保守・改修", value: "月額30万円〜（税別）" },
  { label: "周辺機能・新規システム開発", value: "個別見積もり" },
];
const websitePlanPresentation = {
  "one-page": {
    title: "1ページ会社サイト制作",
    description: "会社概要、サービス、代表者情報、問い合わせなどを1ページにまとめたい事業者向け",
  },
  "five-page": {
    title: "最大5ページのコーポレートサイト制作",
    description:
      "会社情報やサービス内容をページごとに分け、一般的な会社サイトとして整備したい事業者向け",
  },
} as const;
---

<BaseLayout
  title="サービス・料金｜既存システム支援・Web制作｜FALXTER株式会社"
  description={description}
  breadcrumbs={[{ name: "トップ", url: "/" }, { name: "サービス", url: "/services/" }]}
>
  <header class="page-head">
    <div class="container">
      <p class="breadcrumbs"><a href="/">トップ</a> / サービス</p>
      <p class="eyebrow">Services</p>
      <h1 class="heading services-heading">既存システム支援とコーポレートサイト制作</h1>
      <p class="lead services-lead">
        既存業務システムの調査・引き継ぎ・保守・改修を主軸に、周辺機能・新規システムの開発と、中小企業向けコーポレートサイト制作を提供します。技術者が直接、ご相談から実施まで一貫して対応します。
      </p>
    </div>
  </header>

  <div class="section service-catalog">
    <section id="system-support" class="container service-domain system-domain" aria-labelledby="system-domain-heading">
      <header class="domain-heading">
        <p class="eyebrow">System support</p>
        <h2 id="system-domain-heading">既存システム支援</h2>
        <p>
          状況の調査から引き継ぎ、保守・改修、周辺機能の開発まで、現在のシステム構成に合わせて対応します。
        </p>
      </header>

      <div class="system-service-grid">
        <article class="card service-card">
          <h3>既存システムの調査・引き継ぎ</h3>
          <p class="service-description">
            担当者の退職、資料不足、技術の老朽化などにより状況が分からなくなった既存システムを調査します。コード、データベース、実行環境、運用方法を確認し、引き継ぎに必要な情報と今後の対応方針を整理します。
          </p>
          <dl class="service-meta">
            <div>
              <dt>対象</dt>
              <dd>担当者不在、資料不足、構成や仕様が分からないシステム</dd>
            </div>
          </dl>
          <div class="pricing">
            <p class="pricing-heading">料金</p>
            <dl class="price-list">
              <div>
                <dt>調査・引き継ぎ</dt>
                <dd>50万円〜（税別）</dd>
              </div>
            </dl>
          </div>
          <a class="button secondary service-card__link" href="/services/system-support/#assessment">
            詳しく見る
          </a>
        </article>

        <article class="card service-card">
          <h3>既存システムの保守・改修</h3>
          <p class="service-note">周辺機能・新規システム開発にも対応</p>
          <p class="service-description">
            既存の業務システムやWebアプリケーションを対象に、不具合調査、機能追加、テスト、リリース、運用保守を行います。既存環境と連携する管理画面、API、バッチなどの周辺機能や、中小規模の新規システム開発もご相談いただけます。
          </p>
          <dl class="service-meta">
            <div>
              <dt>対象</dt>
              <dd>不具合修正、機能追加、継続保守、既存環境と連携する機能の開発</dd>
            </div>
          </dl>
          <div class="pricing">
            <p class="pricing-heading">料金</p>
            <dl class="price-list">
              {maintenancePrices.map((item) => (
                <div>
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))}
            </dl>
          </div>
          <a class="button secondary service-card__link" href="/services/system-support/#spot-maintenance">
            詳しく見る
          </a>
        </article>
      </div>
    </section>

    <section class="container service-domain web-domain" aria-labelledby="web-domain-heading">
      <header class="domain-heading">
        <p class="eyebrow">Corporate website</p>
        <h2 id="web-domain-heading">コーポレートサイト制作</h2>
        <p>
          会社や事業の情報を整理し、スマートフォン対応と問い合わせフォームを備えたコーポレートサイトを固定料金で制作します。
        </p>
      </header>

      <article class="card service-card web-service-card">
        <h3>中小企業向けコーポレートサイト制作</h3>
        <p class="service-description">
          会社や事業の情報量に合わせて、1ページ完結の会社サイトと、最大5ページのコーポレートサイトを制作します。どちらもスマートフォン対応、問い合わせフォーム、基本SEO、アクセス解析設定、公開作業を含みます。
        </p>
        <dl class="service-meta">
          <div>
            <dt>対象</dt>
            <dd>新しく会社サイトを用意したい中小企業・個人事業者</dd>
          </div>
        </dl>
        <div class="website-plan-grid">
          {websitePlans.map((plan) => {
            const presentation = websitePlanPresentation[plan.id];
            return (
              <section class="website-plan" aria-labelledby={`website-plan-${plan.id}`}>
                <h4 id={`website-plan-${plan.id}`}>{presentation.title}</h4>
                <p class="website-plan-description">{presentation.description}</p>
                <dl class="website-plan-facts">
                  <div>
                    <dt>料金</dt>
                    <dd>{plan.price}</dd>
                  </div>
                  <div>
                    <dt>構成</dt>
                    <dd>
                      {plan.pageCount}{plan.id === "one-page" ? `・${plan.structure}` : ""}
                    </dd>
                  </div>
                  <div>
                    <dt>期間</dt>
                    <dd>{plan.duration}</dd>
                  </div>
                </dl>
              </section>
            );
          })}
        </div>
        <a class="button secondary service-card__link" href="/services/corporate-website/">
          詳しく見る
        </a>
      </article>
    </section>
  </div>

  <section class="section services-cta" aria-labelledby="services-cta-heading">
    <div class="narrow">
      <p class="eyebrow">Contact</p>
      <h2 id="services-cta-heading">どのサービスが適切か分からない場合も、ご相談ください。</h2>
      <p>
        現在の状況や希望する対応を確認し、必要な進め方をご案内します。資料や仕様が整理されていなくても問題ありません。
      </p>
      <a class="button" href="/contact/">サービスについて相談する</a>
    </div>
  </section>
</BaseLayout>

<style>
  .services-heading{word-break:auto-phrase}.services-lead{max-width:62rem;word-break:auto-phrase}.service-catalog{display:grid;gap:clamp(4rem,7vw,6rem)}.service-domain{display:grid;gap:2rem}.domain-heading{max-width:58rem}.domain-heading h2{margin:.55rem 0 .75rem;font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.4}.domain-heading p:last-child{margin:0;color:var(--color-body);font-size:1.0625rem;line-height:1.8}.system-service-grid{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);align-items:start;gap:1rem}.service-card{display:flex;min-width:0;flex-direction:column;border-top:4px solid var(--color-primary)}.service-card h3{margin:0 0 .85rem;font-size:clamp(1.3rem,2vw,1.55rem);line-height:1.5}.service-note{margin:-.3rem 0 .85rem!important;color:var(--color-primary)!important;font-size:.95rem!important;font-weight:800;line-height:1.6!important}.service-description{margin:0!important;color:var(--color-body)!important;font-size:1rem!important;line-height:1.8!important}.service-meta{margin:1.25rem 0 0;border-top:1px solid var(--color-border)}.service-meta div{display:grid;grid-template-columns:4rem minmax(0,1fr);gap:.75rem;padding:.8rem 0;border-bottom:1px solid var(--color-border)}.service-meta dt,.pricing-heading{color:var(--color-primary);font-size:.875rem;font-weight:800}.service-meta dd{margin:0;color:var(--color-body);font-size:1rem;line-height:1.7}.pricing{margin:1.25rem 0 1.5rem}.pricing-heading{margin:0 0 .5rem}.price-list{margin:0;border-top:1px solid var(--color-border)}.price-list div{display:grid;grid-template-columns:minmax(10rem,.9fr) minmax(0,1.1fr);gap:1rem;padding:.75rem 0;border-bottom:1px solid var(--color-border)}.price-list dt{color:var(--color-text);font-size:.9rem;font-weight:750;line-height:1.6}.price-list dd{margin:0;color:var(--color-body);font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.92rem;font-weight:700;line-height:1.6}.service-card__link{align-self:flex-start;margin-top:auto}.website-plan-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin:1.5rem 0}.website-plan{display:flex;min-width:0;flex-direction:column;padding:clamp(1.15rem,2vw,1.5rem);border:1px solid var(--color-border);background:#fff}.website-plan h4{margin:0 0 .65rem;color:var(--color-text);font-size:1.1rem;line-height:1.55;word-break:auto-phrase}.website-plan-description{margin:0;color:var(--color-body);font-size:1rem;line-height:1.75}.website-plan-facts{margin:auto 0 0;padding-top:1rem}.website-plan-facts div{display:grid;grid-template-columns:4rem minmax(0,1fr);gap:.75rem;padding:.55rem 0;border-top:1px solid var(--color-border)}.website-plan-facts dt{color:var(--color-primary);font-size:.82rem;font-weight:800}.website-plan-facts dd{margin:0;color:var(--color-body);font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.92rem;font-weight:700;line-height:1.55}.website-plan-facts div:first-child dd{color:var(--color-text);font-size:1.08rem}.web-domain{padding-top:clamp(2rem,4vw,3.5rem);border-top:1px solid var(--color-border)}.web-service-card{width:100%;border-top-color:#a79791;background:#fbfaf8}.services-cta{border-top:1px solid var(--color-border);text-align:center}.services-cta h2{margin:.8rem 0 1rem;font-size:clamp(1.6rem,3.5vw,2.75rem);line-height:1.45;word-break:auto-phrase}.services-cta p:not(.eyebrow){margin:0 auto 1.5rem;color:var(--color-body);font-size:1.0625rem;line-height:1.8}@media(max-width:800px){.system-service-grid{grid-template-columns:1fr}.price-list div{grid-template-columns:1fr;gap:.2rem}}@media(max-width:650px){.website-plan-grid{grid-template-columns:1fr}}@media(max-width:480px){.service-meta div{grid-template-columns:1fr;gap:.2rem}.service-card__link{width:100%}}
</style>
