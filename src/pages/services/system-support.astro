---
import {
  systemSupportConsultations,
  systemSupportExclusions,
  systemSupportFaqs,
  systemSupportPageNavigation,
  systemSupportProcess,
  systemSupportSections,
  systemSupportTechnologies,
} from "../../data/systemSupport";
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "既存システムの調査・引き継ぎ・保守・改修｜FALXTER株式会社";
const description =
  "資料や仕様が十分でない既存業務システムの調査・引き継ぎから、スポット改修、継続保守、周辺機能・新規システム開発まで対応します。";
const contactHref = "/contact/?service=system-consultation";
const serviceUrl = new URL("/services/system-support/", Astro.site).toString();
const serviceStructuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "既存システム支援",
  serviceType: "既存業務システムの調査・引き継ぎ・保守・改修",
  description,
  url: serviceUrl,
  provider: {
    "@type": "Organization",
    name: "FALXTER株式会社",
    url: new URL("/", Astro.site).toString(),
  },
};
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[
    { name: "トップ", url: "/" },
    { name: "サービス", url: "/services/" },
    { name: "既存システム支援", url: "/services/system-support/" },
  ]}
>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(serviceStructuredData)}
  />

  <header class="page-head support-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="パンくずリスト">
        <a href="/">トップ</a><span aria-hidden="true">/</span><a href="/services/">サービス</a><span
          aria-hidden="true">/</span
        ><span>既存システム支援</span>
      </nav>
      <p class="eyebrow">SERVICE</p>
      <h1 class="heading">既存システム支援</h1>
      <p class="support-lead">
        資料や仕様が十分でない既存業務システムの調査・引き継ぎから、不具合修正、機能追加、継続保守、周辺機能・新規システム開発まで、現在の状況に合わせて対応します。技術者が直接、ご相談から実施まで一貫して対応します。
      </p>
      <a class="button secondary support-hero-cta" href={contactHref}>既存システムについて相談する</a>
    </div>
  </header>

  <nav class="support-page-nav" aria-label="既存システム支援のページ内メニュー">
    <div class="container">
      <ul>
        {systemSupportPageNavigation.map((item, index) => (
          <li>
            <a href={item.href}><span>{String(index + 1).padStart(2, "0")}</span>{item.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <section class="section consultation-section" aria-labelledby="consultation-heading">
    <div class="container">
      <p class="route-note">
        状況に応じて、必要な工程から対応します。修正内容が明確な場合は、調査・引き継ぎを経ずに、スポット保守・改修から開始できます。
      </p>
      <div class="section-heading compact-heading">
        <p class="eyebrow">CONSULTATION</p>
        <h2 id="consultation-heading">このような状況に対応します</h2>
      </div>
      <ol class="consultation-list">
        {systemSupportConsultations.map((item, index) => (
          <li><span>{String(index + 1).padStart(2, "0")}</span><p>{item}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <div class="support-options">
    {systemSupportSections.map((service) => (
      <section
        class="section support-option"
        id={service.id}
        aria-labelledby={`${service.id}-heading`}
      >
        <div class="container support-option-grid">
          <header class="support-option-summary">
            <p class="option-number">{service.number}</p>
            <h2 id={`${service.id}-heading`}>{service.title}</h2>
            <dl class="option-meta">
              <div>
                <dt>料金</dt>
                <dd>{service.price}</dd>
              </div>
              <div>
                <dt>{service.termsLabel}</dt>
                <dd>{service.terms}</dd>
              </div>
            </dl>
            <a class="text-link" href={`/contact/?service=${service.contactService}`}>
              この内容について相談する <span aria-hidden="true">→</span>
            </a>
          </header>

          <div class="support-option-content">
            <section aria-labelledby={`${service.id}-audience-heading`}>
              <h3 id={`${service.id}-audience-heading`}>対象となる状況</h3>
              <p>{service.audience}</p>
            </section>
            <section aria-labelledby={`${service.id}-description-heading`}>
              <h3 id={`${service.id}-description-heading`}>対応内容</h3>
              <p>{service.description}</p>
            </section>
            {service.groups.map((group, groupIndex) => (
              <section aria-labelledby={`${service.id}-items-${groupIndex}-heading`}>
                <h3 id={`${service.id}-items-${groupIndex}-heading`}>{group.label}</h3>
                <ul class="detail-list">
                  {group.items.map((item) => <li>{item}</li>)}
                </ul>
              </section>
            ))}
            {service.note && <p class="option-note">{service.note}</p>}
          </div>
        </div>
      </section>
    ))}
  </div>

  <section class="section surface process-section" aria-labelledby="process-heading">
    <div class="container">
      <div class="section-heading compact-heading">
        <p class="eyebrow">PROCESS</p>
        <h2 id="process-heading">対応の進め方</h2>
      </div>
      <ol class="support-process">
        {systemSupportProcess.map((step) => (
          <li>
            <span>{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section technology-section" aria-labelledby="technology-heading">
    <div class="container information-grid">
      <div>
        <p class="eyebrow">TECHNOLOGY</p>
        <h2 id="technology-heading">主な経験技術</h2>
      </div>
      <div>
        <dl class="technology-list">
          {systemSupportTechnologies.map((technology) => (
            <div>
              <dt>{technology.label}</dt>
              <dd>{technology.value}</dd>
            </div>
          ))}
        </dl>
        <p class="information-note">
          上記は主な経験技術です。記載のない技術についても、システム構成、バージョン、依存ライブラリ、実行環境を確認した上で対応可否をご案内します。
        </p>
      </div>
    </div>
  </section>

  <section class="section surface exclusions-section" aria-labelledby="exclusions-heading">
    <div class="container information-grid">
      <div>
        <p class="eyebrow">SCOPE</p>
        <h2 id="exclusions-heading">対応できない範囲</h2>
      </div>
      <div>
        <ul class="exclusion-list">
          {systemSupportExclusions.map((item) => <li>{item}</li>)}
        </ul>
        <p class="information-note">
          調査報告書は、事前に合意した調査対象と確認可能な情報に基づいて作成します。すべての機能や仕様を完全に復元・保証するものではありません。
        </p>
      </div>
    </div>
  </section>

  <section class="section faq-section" aria-labelledby="faq-heading">
    <div class="container faq-container">
      <div class="section-heading compact-heading">
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-heading">よくある質問</h2>
      </div>
      <div class="faq-list">
        {systemSupportFaqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section support-cta" aria-labelledby="support-cta-heading">
    <div class="narrow">
      <p class="eyebrow">CONTACT</p>
      <h2 id="support-cta-heading">状況を整理するところから、ご相談ください。</h2>
      <p>
        資料や仕様が十分でない場合も、分かる範囲で現在の状況をお知らせください。必要な対応と進め方を整理します。
      </p>
      <a class="button" href={contactHref}>既存システムについて相談する</a>
    </div>
  </section>
</BaseLayout>

<style>
  .support-hero h1{max-width:58rem;word-break:keep-all}.support-lead{max-width:66rem;margin:1.5rem 0 0;color:var(--color-body);font-size:1.125rem;line-height:1.9}.support-hero-cta{margin-top:1.75rem}.support-page-nav{border-block:1px solid var(--color-border);background:#fff}.support-page-nav ul{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:0;padding:0;list-style:none}.support-page-nav li+li{border-left:1px solid var(--color-border)}.support-page-nav a{display:flex;min-height:64px;align-items:center;gap:.65rem;padding:.75rem 1rem;color:var(--color-text);font-size:.95rem;font-weight:750;line-height:1.45;text-decoration:none}.support-page-nav a:hover,.support-page-nav a:focus-visible{background:var(--color-surface)}.support-page-nav a span{flex:0 0 auto;color:var(--color-primary);font:800 .75rem/1 ui-monospace,SFMono-Regular,Consolas,monospace;letter-spacing:.08em}.consultation-section{padding-bottom:clamp(3.5rem,7vw,6rem)}.route-note{margin:0 0 clamp(3rem,6vw,5rem);padding:1.15rem 1.35rem;border-left:4px solid var(--color-primary);background:var(--color-surface);color:var(--color-text);font-size:1.0625rem;font-weight:700;line-height:1.8}.compact-heading{margin-bottom:2rem}.compact-heading h2,.information-grid h2{margin:.55rem 0 0;font-size:clamp(1.8rem,3.5vw,2.65rem);line-height:1.4}.consultation-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:0;padding:0;border-top:1px solid var(--color-border);list-style:none}.consultation-list li{min-width:0;padding:1.25rem 1rem 1.35rem;border-right:1px solid var(--color-border);border-bottom:1px solid var(--color-border)}.consultation-list li:nth-child(4n){border-right:0}.consultation-list span,.option-number,.support-process>li>span{color:var(--color-primary);font:800 .78rem/1 ui-monospace,SFMono-Regular,Consolas,monospace;letter-spacing:.1em}.consultation-list p{margin:.7rem 0 0;color:var(--color-body);font-size:1rem;font-weight:650;line-height:1.7}.support-options{border-top:1px solid var(--color-border)}.support-option{padding-block:clamp(4rem,7vw,6rem);border-bottom:1px solid var(--color-border);background:#fff}.support-option:nth-child(even){background:#fbfaf8}.support-option-grid{display:grid;grid-template-columns:minmax(16rem,.72fr) minmax(0,1.28fr);gap:clamp(3rem,7vw,7rem);align-items:start}.support-option-summary{position:sticky;top:7.5rem}.option-number{margin:0 0 1.1rem}.support-option-summary h2{margin:0;font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.45;word-break:auto-phrase}.option-meta{margin:2rem 0 1.25rem;border-top:1px solid var(--color-border)}.option-meta div{padding:1rem 0;border-bottom:1px solid var(--color-border)}.option-meta dt{margin-bottom:.3rem;color:var(--color-primary);font-size:.8rem;font-weight:800;letter-spacing:.04em}.option-meta dd{margin:0;color:var(--color-text);font-size:1rem;font-weight:750;line-height:1.65}.text-link{display:inline-flex;min-height:48px;align-items:center;gap:.4rem;color:var(--color-primary);font-weight:750}.text-link span{transition:transform .2s ease}.text-link:hover span,.text-link:focus-visible span{transform:translateX(3px)}.support-option-content{display:grid;gap:2rem}.support-option-content section{padding-top:1rem;border-top:1px solid var(--color-border)}.support-option-content h3{margin:0 0 .65rem;font-size:1.1rem;line-height:1.5}.support-option-content p{margin:0;color:var(--color-body);font-size:1.0625rem;line-height:1.85}.detail-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem 1.5rem;margin:0;padding:0;list-style:none}.detail-list li{position:relative;padding-left:1.1rem;color:var(--color-body);font-size:1rem;line-height:1.7}.detail-list li::before{position:absolute;top:.72em;left:0;width:.45rem;border-top:1px solid var(--color-primary);content:""}.option-note{padding:1rem 1.15rem;border-left:3px solid #b59b63;background:var(--color-surface);color:var(--color-text)!important;font-weight:650}.surface{background:var(--color-surface)}.support-process{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:0;padding:0;border-top:3px solid var(--color-primary);list-style:none}.support-process li{min-width:0;padding:1.35rem 1rem;border-right:1px solid var(--color-border)}.support-process li:last-child{border-right:0}.support-process h3{margin:.8rem 0 .5rem;font-size:1.05rem;line-height:1.55}.support-process p{margin:0;color:var(--color-body);font-size:1rem;line-height:1.75}.information-grid{display:grid;grid-template-columns:minmax(15rem,.55fr) minmax(0,1.45fr);gap:clamp(3rem,7vw,7rem);align-items:start}.technology-list{margin:0;border-top:1px solid var(--color-border)}.technology-list div{display:grid;grid-template-columns:minmax(10rem,.45fr) minmax(0,1.55fr);gap:1rem;padding:1rem 0;border-bottom:1px solid var(--color-border)}.technology-list dt{color:var(--color-primary);font-size:.9rem;font-weight:800}.technology-list dd{margin:0;color:var(--color-text);font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.98rem;line-height:1.75}.information-note{margin:1.5rem 0 0;padding:1rem 1.15rem;border-left:3px solid #b59b63;background:#fff;color:var(--color-body);font-size:1rem;line-height:1.8}.technology-section .information-note{background:var(--color-surface)}.exclusions-section h2{word-break:keep-all;overflow-wrap:normal;text-wrap:balance}.exclusion-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem 1.5rem;margin:0;padding:0;list-style:none}.exclusion-list li{padding:.75rem 0;border-bottom:1px solid var(--color-border);color:var(--color-body);font-size:1rem;line-height:1.7}.faq-container{max-width:68rem}.faq-list{border-top:1px solid var(--color-border)}.faq-list details{border-bottom:1px solid var(--color-border)}.faq-list summary{display:flex;min-height:64px;align-items:center;padding:1rem 2.5rem 1rem 0;color:var(--color-text);font-size:1.0625rem;font-weight:750;line-height:1.6;cursor:pointer}.faq-list p{margin:0;padding:0 2rem 1.25rem;color:var(--color-body);font-size:1rem;line-height:1.8}.support-cta{border-top:1px solid var(--color-border);text-align:center}.support-cta h2{margin:.8rem 0 1rem;font-size:clamp(1.8rem,4vw,3rem);line-height:1.45;word-break:auto-phrase}.support-cta p:not(.eyebrow){margin:0 auto 1.75rem;color:var(--color-body);font-size:1.0625rem;line-height:1.85}
  @media(min-width:901px){.exclusions-section .information-grid{grid-template-columns:minmax(18rem,.65fr) minmax(0,1.35fr)}}
  @media(max-width:900px){.consultation-list{grid-template-columns:repeat(2,minmax(0,1fr))}.consultation-list li:nth-child(4n){border-right:1px solid var(--color-border)}.consultation-list li:nth-child(2n){border-right:0}.support-option-grid,.information-grid{grid-template-columns:1fr;gap:2.5rem}.support-option-summary{position:static}.support-process{grid-template-columns:repeat(2,minmax(0,1fr))}.support-process li:nth-child(2){border-right:0}.support-process li:nth-child(-n+2){border-bottom:1px solid var(--color-border)}}
  @media(max-width:700px){.support-page-nav ul{grid-template-columns:repeat(2,minmax(0,1fr))}.support-page-nav li+li{border-left:0}.support-page-nav li:nth-child(even){border-left:1px solid var(--color-border)}.support-page-nav li:nth-child(-n+2){border-bottom:1px solid var(--color-border)}.detail-list,.exclusion-list{grid-template-columns:1fr}.technology-list div{grid-template-columns:1fr;gap:.3rem}}
  @media(max-width:520px){.consultation-list,.support-process{grid-template-columns:1fr}.consultation-list li,.consultation-list li:nth-child(2n),.consultation-list li:nth-child(4n),.support-process li{border-right:0}.support-process li:nth-child(3){border-bottom:1px solid var(--color-border)}.support-hero-cta{width:100%}}
</style>