---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import PageHeader from '../components/PageHeader.astro'
import Section from '../components/Section.astro'
import { works } from '../data/works'
---
<BaseLayout title="開発実績・事例紹介 | FALXTER株式会社" description="業務システム、EC、Webサイトなどの主な案件例を紹介します。" url="https://falxter.co.jp/works">
	<Header slot="header" />
	<PageHeader
		title="開発実績・事例紹介"
		description="業務システム刷新からEC構築、Webサイト制作まで、少人数での開発事例をまとめています。"
		breadcrumb={[{ label: 'ホーム', href: '/' }, { label: '事例紹介', href: '/works' }]}
	/>
	<Section subtitle="Works" title="主な案件">
		<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
			{works.map((work) => (
				<article class="card-base space-y-3">
					<h2 class="text-lg font-semibold text-gray-900">{work.name}</h2>
					<p class="text-sm text-gray-700">{work.summary}</p>
					<p class="text-xs font-semibold text-gray-500">使用技術</p>
					<div class="flex flex-wrap gap-2">
						{work.tech.map((item) => (
							<span class="rounded-full bg-gray-100 px-3 py-1 text-xs text-gray-700">{item}</span>
						))}
					</div>
					<p class="text-xs font-semibold text-gray-500">担当範囲</p>
					<p class="text-sm text-gray-700">{work.scope}</p>
				</article>
			))}
		</div>
	</Section>
	<Footer slot="footer" />
</BaseLayout>
