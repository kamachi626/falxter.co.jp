---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import { works } from '../data/works';
---
<BaseLayout title="開発実績・事例紹介 | FALXTER株式会社" description="これまでに手掛けた業務システム、Webアプリ、ECサイトなどの事例を紹介します。">
	<PageHeader title="開発実績・事例紹介" description="公開可能な範囲で、プロジェクトの概要と担当範囲を掲載しています。" badge="Works" />
	<Section>
		<div class="grid gap-6 md:grid-cols-2">
			{works.map((work) => (
				<Card title={work.title}>
					<p class="text-sm font-semibold text-primary">{work.category}</p>
					<p>{work.overview}</p>
					<div class="mt-3 space-y-2 text-sm text-gray-700">
						<p class="font-semibold">使用技術</p>
						<ul class="flex flex-wrap gap-2">
							{work.tech.map((tech) => (
								<span class="badge bg-primary/5 text-primary">{tech}</span>
							))}
						</ul>
						<p class="font-semibold">担当範囲</p>
						<ul class="list-disc space-y-1 pl-5">
							{work.roles.map((role) => <li>{role}</li>)}
						</ul>
					</div>
				</Card>
			))}
		</div>
	</Section>
</BaseLayout>
