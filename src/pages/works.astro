---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import Section from '@components/Section.astro';
import Card from '@components/Card.astro';
import Badge from '@components/Badge.astro';
import { works } from '@data/works';
---
<BaseLayout title="事例紹介 | FALXTER株式会社" description="開発事例と使用技術のダイジェスト">
<PageHeader title="開発実績・事例紹介" description="業務システムからWebアプリ、ECまで幅広く支援しています。" />
<Section eyebrow="Works" title="実績一覧">
<div class="grid gap-6 md:grid-cols-2">
{works.map((work) => (
<Card title={work.title} subtitle={work.category} description={work.description}>
<p class="text-xs font-semibold text-neutral-600">使用技術</p>
<div class="flex flex-wrap gap-2">
{work.tech.map((tech) => (
<Badge label={tech} />
))}
</div>
<p class="text-xs font-semibold text-neutral-600 mt-2">担当範囲</p>
<p>{work.scope}</p>
</Card>
))}
</div>
</Section>
</BaseLayout>
