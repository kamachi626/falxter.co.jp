---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { works } from '../data/works';
---
<BaseLayout title="開発実績・事例紹介 | FALXTER株式会社" description="業務システム、Webアプリ、ECサイト、Webサイト制作の実績例を掲載しています。">
	<PageHeader title="開発実績・事例紹介" subtitle="公開可能な範囲の架空事例です。目的に合わせた開発スタイルをご提案します。" />
	<Section title="案件一覧" description="案件データを配列からループして表示しています。">
		<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
			{works.map((work) => (
				<article class="flex h-full flex-col rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">
					<p class="text-xs font-semibold text-primary">{work.category}</p>
					<h2 class="mt-2 text-lg font-semibold text-gray-900">{work.title}</h2>
					<p class="mt-2 flex-1 text-sm text-gray-700">{work.description}</p>
					<div class="mt-3 space-y-1 text-xs text-gray-600">
						<p class="font-semibold text-gray-800">使用技術</p>
						<p class="rounded bg-gray-50 px-3 py-2">{work.technologies.join(', ')}</p>
						<p class="pt-2 font-semibold text-gray-800">担当範囲</p>
						<p class="rounded bg-gray-50 px-3 py-2">{work.scope}</p>
					</div>
				</article>
			))}
		</div>
	</Section>
</BaseLayout>
