---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { siteConfig } from '../site.config';

const meta = {
  title: '会社概要 | FALXTER株式会社',
  description: 'FALXTER株式会社の会社概要、代表挨拶、取引形態などの情報を掲載しています。'
};
---
<BaseLayout title={meta.title} description={meta.description} path="/about">
  <section class="bg-white py-14">
    <div class="container-responsive space-y-12">
      <SectionHeading title="会社概要" description="基本情報と代表メッセージを掲載しています。" />

      <div class="grid gap-8 md:grid-cols-2">
        <div class="rounded-2xl border border-gray-200 bg-gray-50 p-6 shadow-sm">
          <dl class="space-y-4 text-sm text-gray-800">
            <div class="grid grid-cols-3 gap-2">
              <dt class="font-semibold text-gray-700">会社名</dt>
              <dd class="col-span-2">{siteConfig.companyName}</dd>
            </div>
            <div class="grid grid-cols-3 gap-2">
              <dt class="font-semibold text-gray-700">英語名</dt>
              <dd class="col-span-2">{siteConfig.companyNameEn}</dd>
            </div>
            <div class="grid grid-cols-3 gap-2">
              <dt class="font-semibold text-gray-700">代表</dt>
              <dd class="col-span-2">{siteConfig.representative}</dd>
            </div>
            <div class="grid grid-cols-3 gap-2">
              <dt class="font-semibold text-gray-700">所在地</dt>
              <dd class="col-span-2">{siteConfig.address}</dd>
            </div>
            <div class="grid grid-cols-3 gap-2">
              <dt class="font-semibold text-gray-700">電話</dt>
              <dd class="col-span-2"><a href={`tel:${siteConfig.phone.replace(/-/g, '')}`} class="hover:text-brand">{siteConfig.phone}</a></dd>
            </div>
            <div class="grid grid-cols-3 gap-2">
              <dt class="font-semibold text-gray-700">メール</dt>
              <dd class="col-span-2"><a href={`mailto:${siteConfig.email}`} class="hover:text-brand">{siteConfig.email}</a></dd>
            </div>
            <div class="grid grid-cols-3 gap-2">
              <dt class="font-semibold text-gray-700">事業内容</dt>
              <dd class="col-span-2">Web制作、受託開発、保守運用・改善、開発支援</dd>
            </div>
          </dl>
        </div>

        <div class="space-y-6">
          <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-semibold text-gray-900">代表挨拶</h2>
            <p class="mt-3 text-sm leading-relaxed text-gray-700">
              エージェント経由の開発支援を中心に、要件整理から実装・運用までフルスタックで担当しています。小さく作って早く出し、運用しながら堅実に改善する進め方を得意としています。
            </p>
          </div>
          <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-semibold text-gray-900">取引形態</h3>
            <ul class="mt-3 space-y-2 text-sm text-gray-700">
              <li class="flex items-start gap-2">
                <span class="mt-1 h-2 w-2 rounded-full bg-brand" aria-hidden="true"></span>
                業務委託（準委任）
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1 h-2 w-2 rounded-full bg-brand" aria-hidden="true"></span>
                請負（TODO: 対応可否や条件を明記）
              </li>
            </ul>
            <p class="mt-3 text-xs text-gray-600">ご要望に合わせて柔軟に検討します。契約形態や条件は個別にご相談ください。</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
