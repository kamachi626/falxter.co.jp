---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import { services } from '../data/services';
import { works } from '../data/works';
import { newsList } from '../data/news';
---
<BaseLayout title="FALXTER株式会社 | ソフトウェア開発・Webシステム開発" description="小さなチームで柔軟に対応するソフトウェア開発会社。業務システム・Webアプリ・ECサイト・Web制作を支援します。">
	<section class="bg-gray-50">
		<div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-14 md:flex-row md:items-center md:justify-between md:px-6">
			<div class="space-y-4">
				<p class="text-sm font-semibold uppercase tracking-wide text-primary">The Software Development Company.</p>
				<h1 class="text-3xl font-bold leading-snug text-gray-900 md:text-4xl">FALXTER株式会社<br class="hidden md:block" />ソフトウェア開発・Webシステム開発</h1>
				<p class="max-w-2xl text-base text-gray-700 md:text-lg">小規模だからこそできるスピードと柔軟性で、業務システムからWebアプリ、ECサイトまで伴走します。</p>
				<div class="flex flex-wrap gap-3">
					<Button href="/contact" size="lg">お問い合わせ</Button>
					<Button href="/services" variant="ghost" size="lg">サービスを見る</Button>
				</div>
			</div>
			<div class="grid w-full gap-4 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm md:max-w-md">
				<div class="flex items-center justify-between">
					<p class="text-sm font-medium text-gray-700">主要サービス</p>
					<span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">Full Stack</span>
				</div>
				<ul class="space-y-3 text-sm text-gray-800">
					<li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 rounded-full bg-primary"></span>業務システム・基幹システムの開発とリプレイス</li>
					<li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 rounded-full bg-primary"></span>Webアプリケーションの新規開発・改善</li>
					<li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 rounded-full bg-primary"></span>EC-CUBE / Shopify を活用したEC構築</li>
					<li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 rounded-full bg-primary"></span>コーポレートサイト・採用サイト制作</li>
				</ul>
			</div>
		</div>
	</section>
	<Section id="services" title="提供サービス" description="業務システム開発、Webアプリ、EC、Web制作をワンストップで支援します。">
		<div class="grid gap-6 md:grid-cols-2">
			{services.map((service) => (
				<article class="h-full rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
					<div class="flex items-center justify-between">
						<h3 class="text-xl font-semibold text-gray-900">{service.title}</h3>
						<span class="text-xs font-semibold text-primary">{service.clients}</span>
					</div>
					<p class="mt-3 text-sm text-gray-700">{service.description}</p>
					<ul class="mt-3 space-y-2 text-xs text-gray-700">
						{service.features.map((feature) => (
							<li class="flex gap-2"><span class="mt-1 h-2 w-2 rounded-full bg-primary"></span>{feature}</li>
						))}
					</ul>
					<p class="mt-4 text-xs font-semibold text-gray-600">使用技術例: <span class="font-normal">{service.technologies.join(', ')}</span></p>
				</article>
			))}
		</div>
	</Section>
	<Section id="strengths" title="私たちの強み" description="小さなチームならではの意思決定の速さと柔軟な対応力で、目的に合わせた開発を行います。">
		<div class="grid gap-6 md:grid-cols-3">
			{['フルスタックで一気通貫', 'リモート中心の軽快な連携', '長期的な伴走と改善'].map((strength) => (
				<div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
					<h3 class="text-lg font-semibold text-gray-900">{strength}</h3>
					<p class="mt-3 text-sm text-gray-700">現場に合わせた進め方で、要件整理から運用改善まで寄り添います。</p>
				</div>
			))}
		</div>
	</Section>
	<Section id="works" title="開発実績ダイジェスト" description="公開可能な範囲で抜粋した架空案件例です。詳細な実績はお問い合わせください。">
		<div class="grid gap-6 md:grid-cols-3">
			{works.slice(0,3).map((work) => (
				<article class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">
					<p class="text-xs font-semibold text-primary">{work.category}</p>
					<h3 class="mt-2 text-lg font-semibold text-gray-900">{work.title}</h3>
					<p class="mt-2 text-sm text-gray-700">{work.description}</p>
					<p class="mt-3 text-xs font-semibold text-gray-600">使用技術: <span class="font-normal">{work.technologies.join(', ')}</span></p>
					<p class="mt-1 text-xs text-gray-600">担当範囲: {work.scope}</p>
				</article>
			))}
		</div>
	</Section>
	<Section id="news" title="お知らせ" description="最新のお知らせやブログ更新情報を掲載しています。">
		<div class="divide-y divide-gray-200 overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
			{newsList.sort((a, b) => b.date.localeCompare(a.date)).slice(0,3).map((news) => (
				<a class="flex items-start gap-4 px-5 py-4 transition hover:bg-gray-50" href={`/news/${news.slug}`}>
					<div class="text-xs font-semibold text-primary">{news.category}</div>
					<div class="flex-1">
						<p class="text-xs text-gray-600">{news.date}</p>
						<p class="text-sm font-semibold text-gray-900">{news.title}</p>
						<p class="text-xs text-gray-700">{news.description}</p>
					</div>
				</a>
			))}
		</div>
		<div slot="action">
			<Button href="/news" variant="ghost">一覧を見る</Button>
		</div>
	</Section>
	<section class="bg-primary text-white">
		<div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-4 py-12 text-center md:px-6 md:py-14">
			<p class="text-sm font-semibold uppercase tracking-wide">Contact</p>
			<h2 class="text-2xl font-bold md:text-3xl">ご相談・お問い合わせ</h2>
			<p class="max-w-2xl text-sm md:text-base">システム開発やサイト制作のご相談をお待ちしています。要件が固まっていない段階でもお気軽にご連絡ください。</p>
			<Button href="/contact" variant="ghost" size="lg" class="text-primary">お問い合わせフォームへ</Button>
		</div>
	</section>
</BaseLayout>
