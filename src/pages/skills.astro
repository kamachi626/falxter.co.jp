---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import PageHeader from '../components/PageHeader.astro'
import Section from '../components/Section.astro'
import { skillCategories } from '../data/skills'
---
<BaseLayout title="スキル・技術スタック | FALXTER株式会社" description="バックエンドからフロント、クラウドまで幅広く対応します。" url="https://falxter.co.jp/skills">
	<Header slot="header" />
	<PageHeader
		title="スキル・技術スタック"
		description="主要なプログラミング言語、フレームワーク、データベース、インフラ環境をまとめています。"
		breadcrumb={[{ label: 'ホーム', href: '/' }, { label: 'スキル', href: '/skills' }]}
	/>
	<Section subtitle="Skills" title="対応技術一覧">
		<div class="grid gap-6 md:grid-cols-2">
			{skillCategories.map((category) => (
				<article class="card-base">
					<h2 class="text-lg font-semibold text-gray-900">{category.category}</h2>
					<ul class="mt-3 flex flex-wrap gap-2 text-sm text-gray-700">
						{category.items.map((item) => (
							<li class="rounded-full bg-gray-100 px-3 py-1">{item}</li>
						))}
					</ul>
				</article>
			))}
		</div>
	</Section>
	<Footer slot="footer" />
</BaseLayout>
