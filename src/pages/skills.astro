---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import { skillCategories } from '../data/skills';
---
<BaseLayout title="スキル・技術スタック | FALXTER株式会社" description="取り扱い技術やスキル領域について、カテゴリー別に紹介します。">
	<PageHeader title="スキル・技術スタック" description="バックエンドからフロントエンド、インフラまで幅広く対応します。" badge="Skills" />
	<Section>
		<div class="grid gap-6 md:grid-cols-2">
			{skillCategories.map((category) => (
				<Card title={category.name}>
					<ul class="flex flex-wrap gap-2">
						{category.items.map((item) => (
							<span class="badge bg-primary/5 text-primary">{item}</span>
						))}
					</ul>
				</Card>
			))}
		</div>
	</Section>
</BaseLayout>
