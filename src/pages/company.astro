---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---
<BaseLayout title="会社概要 | FALXTER株式会社" description="FALXTER株式会社の会社概要、所在地、事業内容、連絡先を掲載しています。">
	<PageHeader title="会社概要" description="小規模でも責任感と技術力で伴走する開発会社です。" badge="Company" />
	<section class="section-padding bg-white">
		<div class="container-base grid gap-10 lg:grid-cols-2">
			<div class="card-shadow rounded-lg bg-gray-50 p-6">
				<h2 class="text-xl font-semibold text-gray-900">基本情報</h2>
				<dl class="mt-4 grid grid-cols-3 gap-3 text-sm text-gray-800">
					<dt class="font-semibold text-gray-700">会社名</dt>
					<dd class="col-span-2">FALXTER株式会社 (FALXTER K.K.)</dd>
					<dt class="font-semibold text-gray-700">所在地</dt>
					<dd class="col-span-2">東京都八王子市</dd>
					<dt class="font-semibold text-gray-700">代表者</dt>
					<dd class="col-span-2">佐藤 大輔</dd>
					<dt class="font-semibold text-gray-700">設立</dt>
					<dd class="col-span-2">2014年9月12日</dd>
					<dt class="font-semibold text-gray-700">資本金</dt>
					<dd class="col-span-2">3,000,000円</dd>
					<dt class="font-semibold text-gray-700">従業員数</dt>
					<dd class="col-span-2">1名</dd>
					<dt class="font-semibold text-gray-700">取引銀行</dt>
					<dd class="col-span-2">東京第一銀行 八王子支店</dd>
			</dl>
			</div>
			<div class="space-y-6">
				<div class="card-shadow rounded-lg bg-white p-6">
					<h2 class="text-xl font-semibold text-gray-900">事業内容</h2>
					<ul class="mt-3 list-disc space-y-2 pl-5 text-gray-800">
						<li>業務システム・Webアプリケーションの設計・開発・保守</li>
						<li>ECサイト構築・カスタマイズ（EC-CUBE, Shopifyなど）</li>
						<li>Webサイト制作・パフォーマンス改善・アクセシビリティ対応</li>
					</ul>
				</div>
				<div class="card-shadow rounded-lg bg-white p-6">
					<h2 class="text-xl font-semibold text-gray-900">連絡先</h2>
					<dl class="mt-3 grid grid-cols-3 gap-3 text-gray-800">
						<dt class="font-semibold text-gray-700">電話</dt>
						<dd class="col-span-2">03-1234-5678</dd>
						<dt class="font-semibold text-gray-700">メール</dt>
						<dd class="col-span-2">info@falxter.co.jp</dd>
						<dt class="font-semibold text-gray-700">受付時間</dt>
						<dd class="col-span-2">平日 10:00 - 18:00（事前調整で柔軟に対応）</dd>
					</dl>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
