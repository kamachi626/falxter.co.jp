---
import { company } from "../data/company";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/company.css";

const overviewRows = [
  ["会社名", company.companyName],
  ["英語表記", company.companyNameEn],
  ["代表者", company.representativeName],
  ["所在地", [company.postalCode, company.address].filter(Boolean).join(" ") || null],
  ["電話番号", company.phone],
  ["メールアドレス", company.email],
  ["設立", company.establishedAt],
  ["資本金", company.capital],
  [
    "事業内容",
    "既存業務システムの調査・引き継ぎ・保守・改修、周辺機能・新規システム開発、コーポレートサイト制作",
  ],
];
const placeholder = "未設定";
const representativeTitleParts = company.representativeTitle?.split("／") ?? [];
const description =
  "既存システムの調査・引き継ぎ・保守・改修、周辺機能や新規システムの開発、コーポレートサイト制作に対応するFALXTER株式会社の会社情報です。";
---

<BaseLayout
  title="会社情報｜FALXTER株式会社"
  description={description}
  breadcrumbs={[{ name: "トップ", url: "/" }, { name: "会社情報", url: "/company/" }]}
>
  <header class="page-head company-hero">
    <div class="container">
      <p class="breadcrumbs"><a href="/">トップ</a> / 会社情報</p>
      <p class="eyebrow">Company</p>
      <h1 class="heading">会社情報</h1>
      <p class="lead company-lead">
        既存システムの調査・引き継ぎから、保守・改修、新規開発まで技術者が直接対応します。コーポレートサイト制作もご相談いただけます。
      </p>
    </div>
  </header>

  <section class="section company-overview" aria-labelledby="overview-heading">
    <div class="container information-layout">
      <header class="section-intro">
        <p class="eyebrow">Overview</p>
        <h2 id="overview-heading">会社概要</h2>
        <p>FALXTER株式会社の基本情報と、現在提供している事業領域をご案内します。</p>
      </header>

      <dl class="company-table">
        {
          overviewRows.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd class:list={{ unset: !value }}>
                {label === "電話番号" && value ? (
                  <a href={`tel:${value.replaceAll("-", "")}`}>{value}</a>
                ) : label === "メールアドレス" && value ? (
                  <a href={`mailto:${value}`}>{value}</a>
                ) : (
                  value || placeholder
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section representative-section" aria-labelledby="representative-heading">
    <div class="container">
      <header class="representative-heading">
        <p class="eyebrow">Representative</p>
        <h2 id="representative-heading">代表者紹介</h2>
        <p>技術者が直接、ご相談から実施まで対応します。</p>
      </header>

      <div class="representative-profile">
        <section class="representative-identity" aria-labelledby="representative-name">
          <p class="field-label">FALXTER株式会社</p>
          <h3 id="representative-name" class:list={{ unset: !company.representativeName }}>
            {company.representativeName || placeholder}
          </h3>
          {
            company.representativeTitle ? (
              <p class="representative-role">
                {representativeTitleParts.map((part, index) => (
                  <span>{part}{index < representativeTitleParts.length - 1 ? "／" : ""}</span>
                ))}
              </p>
            ) : (
              <p class="unset">{placeholder}</p>
            )
          }
        </section>

        <section class="profile-summary" aria-labelledby="profile-heading">
          <h3 id="profile-heading">経歴</h3>
          <p>
            ソフトウェアエンジニアとして、Javaを中心とした業務システム開発に13年以上従事してきました。現在は、資料や仕様が十分でないシステムの調査・引き継ぎから、改修、継続保守、周辺機能の開発まで一貫して対応しています。
          </p>
          <p>
            ご相談、対象範囲の整理、設計、実装、公開まで代表者が直接対応し、担当者の途中変更を前提としない進め方を重視しています。
          </p>
        </section>
      </div>

      <div class="expertise-grid">
        <section>
          <h3>得意分野</h3>
          {
            company.specialties.length > 0 ? (
              <ul class="line-list">
                {company.specialties.map((item) => <li>{item}</li>)}
              </ul>
            ) : (
              <p class="unset">{placeholder}</p>
            )
          }
        </section>
        <section>
          <h3>対応工程</h3>
          {
            company.deliveryPhases.length > 0 ? (
              <ul class="line-list">
                {company.deliveryPhases.map((item) => <li>{item}</li>)}
              </ul>
            ) : (
              <p class="unset">{placeholder}</p>
            )
          }
        </section>
      </div>

      <section class="technology-section" aria-labelledby="technology-heading">
        <h3 id="technology-heading">主な経験技術</h3>
        <dl class="technology-list">
          <div>
            <dt>アプリケーション開発</dt>
            <dd>Java / Ruby on Rails / PHP（Laravel） / TypeScript / JavaScript</dd>
          </div>
          <div>
            <dt>データベース</dt>
            <dd>MySQL / PostgreSQL</dd>
          </div>
          <div>
            <dt>インフラ・運用</dt>
            <dd>AWS / Linux / Docker</dd>
          </div>
        </dl>
      </section>
    </div>
  </section>

  <section class="section company-cta" aria-labelledby="company-cta-heading">
    <div class="narrow">
      <p class="eyebrow">Contact</p>
      <h2 id="company-cta-heading">会社やサービスについて、ご相談ください。</h2>
      <p>
        既存システムの状況が分からない場合や、依頼内容が固まっていない段階でも構いません。分かる範囲の情報から進め方を整理します。
      </p>
      <a class="button" href="/contact/">相談内容を送る</a>
    </div>
  </section>
</BaseLayout>
