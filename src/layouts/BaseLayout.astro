---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import '@styles/global.css';

const {
title = 'FALXTER株式会社 | ソフトウェア開発・Webシステム開発',
description = 'FALXTER株式会社は業務システム・Webアプリ開発を中心に支援する小規模ソフトウェア開発会社です。',
ogImage = 'https://falxter.co.jp/og-image.png',
url = 'https://falxter.co.jp',
} = Astro.props as {
title?: string;
description?: string;
ogImage?: string;
url?: string;
};
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta property="og:site_name" content="FALXTER株式会社" />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={ogImage} />
<link rel="icon" href="/favicon.ico" />
</head>
<body class="bg-white text-neutral-900">
<Header />
<main>
<slot />
</main>
<Footer />
</body>
</html>
