---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  primaryText?: string;
  primaryHref?: string;
  secondaryText?: string;
  secondaryHref?: string;
}

const { eyebrow, title, description, primaryHref, primaryText, secondaryHref, secondaryText } = Astro.props;
---
<section class="bg-gradient-to-b from-white to-gray-50">
  <div class="container-responsive grid gap-8 py-16 md:grid-cols-2 md:items-center">
    <div class="space-y-6">
      {eyebrow && <span class="inline-flex w-fit items-center rounded-full bg-brand/10 px-3 py-1 text-xs font-semibold text-brand">{eyebrow}</span>}
      <h1 class="text-3xl font-bold leading-tight text-gray-900 sm:text-4xl">{title}</h1>
      <p class="text-lg leading-relaxed text-gray-700">{description}</p>
      <div class="flex flex-wrap gap-3">
        {primaryHref && primaryText && (
          <a
            href={primaryHref}
            class="inline-flex items-center justify-center rounded-lg bg-brand px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand/90 focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2"
          >
            {primaryText}
          </a>
        )}
        {secondaryHref && secondaryText && (
          <a
            href={secondaryHref}
            class="inline-flex items-center justify-center rounded-lg border border-gray-300 px-5 py-3 text-sm font-semibold text-gray-800 transition hover:border-brand hover:text-brand focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2"
          >
            {secondaryText}
          </a>
        )}
      </div>
    </div>
    <div class="relative overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
      <div class="absolute inset-0 bg-gradient-to-br from-brand/10 via-transparent to-brand/5" aria-hidden="true"></div>
      <div class="relative space-y-4 px-6 py-8">
        <p class="text-sm font-semibold uppercase tracking-wide text-gray-500">中小企業・スタートアップのためのパートナー</p>
        <p class="text-base leading-relaxed text-gray-700">
          ヒアリングから実装・運用まで、必要十分な構成で素早く立ち上げ、公開後も堅実に改善します。小さなチームでも扱いやすいシンプルな仕組みを重視しています。
        </p>
        <ul class="grid gap-2 text-sm text-gray-700 sm:grid-cols-2">
          <li class="flex items-start gap-2">
            <span class="mt-1 h-2 w-2 rounded-full bg-brand" aria-hidden="true"></span>
            速い初期立ち上げと最小構成
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1 h-2 w-2 rounded-full bg-brand" aria-hidden="true"></span>
            要件整理から運用まで一貫支援
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1 h-2 w-2 rounded-full bg-brand" aria-hidden="true"></span>
            静的サイトを中心にセキュアで高速
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1 h-2 w-2 rounded-full bg-brand" aria-hidden="true"></span>
            キーボード操作・ARIAなどアクセシビリティ配慮
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
