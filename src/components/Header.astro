---
const navLinks = [
	{ label: 'ホーム', href: '/' },
	{ label: 'サービス', href: '/services' },
	{ label: 'スキル', href: '/skills' },
	{ label: '事例紹介', href: '/works' },
	{ label: '会社概要', href: '/company' },
	{ label: 'お知らせ', href: '/news' },
	{ label: 'お問い合わせ', href: '/contact' }
];
---
<header class="border-b border-gray-300/60 bg-white/90 backdrop-blur-sm sticky top-0 z-50">
	<div class="container-base flex items-center justify-between py-4">
		<a href="/" class="flex items-center gap-2 font-semibold text-primary text-lg" aria-label="FALXTER K.K. home">
			<span class="inline-flex h-9 w-9 items-center justify-center rounded-md bg-primary text-white font-bold">F</span>
			<span>FALXTER K.K.</span>
		</a>
		<div class="flex items-center gap-3">
			<nav class="hidden md:flex items-center gap-2" aria-label="主要ナビゲーション">
				{navLinks.map((link) => (
					<a href={link.href} class="px-3 py-2 text-sm font-semibold text-gray-800 hover:text-primary" data-testid="nav-link">
						{link.label}
					</a>
				))}
			</nav>
			<button class="inline-flex h-11 w-11 items-center justify-center rounded-md border border-gray-300/70 text-gray-800 hover:text-primary md:hidden" type="button" aria-label="メニューを開閉" aria-expanded="false" data-nav-toggle>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
					<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
				</svg>
			</button>
		</div>
	</div>
	<div class="md:hidden border-t border-gray-200/80 bg-white" data-nav-menu hidden>
		<nav class="container-base flex flex-col gap-1 py-3" aria-label="モバイルナビゲーション">
			{navLinks.map((link) => (
				<a href={link.href} class="rounded-md px-3 py-2 text-sm font-semibold text-gray-800 hover:bg-primary/5" data-testid="mobile-nav-link">
					{link.label}
				</a>
			))}
		</nav>
	</div>
	<script>
		const toggle = document.querySelector('[data-nav-toggle]');
		const menu = document.querySelector('[data-nav-menu]');
		if (toggle && menu) {
			toggle.addEventListener('click', () => {
				const expanded = toggle.getAttribute('aria-expanded') === 'true';
				toggle.setAttribute('aria-expanded', (!expanded).toString());
				menu.toggleAttribute('hidden');
			});
			menu.querySelectorAll('a').forEach((link) => {
				link.addEventListener('click', () => {
					menu.setAttribute('hidden', '');
					toggle.setAttribute('aria-expanded', 'false');
				});
			});
		}
	</script>
</header>
