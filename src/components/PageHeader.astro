---
interface Props {
	title: string;
	subtitle?: string;
}

const { title, subtitle } = Astro.props as Props;
---
<section class="bg-gray-50">
	<div class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
		<p class="text-sm font-semibold uppercase tracking-wide text-primary">The Software Development Company.</p>
		<h1 class="mt-3 text-3xl font-bold text-gray-900 md:text-4xl">{title}</h1>
		{subtitle && <p class="mt-3 max-w-3xl text-base text-gray-700">{subtitle}</p>}
	</div>
</section>
