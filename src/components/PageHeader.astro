---
interface Props {
        title: string;
        subtitle?: string;
        image?: string;
}

const { title, subtitle, image } = Astro.props as Props;
---
<section class="relative overflow-hidden bg-gradient-to-br from-primary/10 via-white to-blue-50">
        <div class="absolute -left-16 top-8 h-40 w-40 rounded-full bg-primary/20 blur-3xl" aria-hidden="true"></div>
        <div class="absolute -right-10 bottom-0 h-52 w-52 rounded-full bg-purple-200/30 blur-3xl" aria-hidden="true"></div>
        <div class="mx-auto flex max-w-6xl flex-col gap-10 px-4 py-12 md:flex-row md:items-center md:justify-between md:px-6 md:py-16">
                <div class="relative z-[1] space-y-3">
                        <p class="inline-flex items-center gap-2 rounded-full bg-white/70 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-primary shadow-sm ring-1 ring-primary/10 backdrop-blur">
                                <span class="inline-block h-2 w-2 rounded-full bg-primary"></span>
                                The Software Development Company.
                        </p>
                        <h1 class="text-3xl font-bold leading-tight text-gray-900 md:text-4xl">{title}</h1>
                        {subtitle && <p class="max-w-3xl text-base text-gray-700 md:text-lg">{subtitle}</p>}
                </div>
                {image && (
                        <div class="relative z-[1] w-full md:max-w-md">
                                <div class="absolute -left-6 -top-6 h-16 w-16 rounded-2xl bg-white/60 shadow-lg ring-1 ring-gray-100" aria-hidden="true"></div>
                                <div class="absolute -right-8 bottom-4 hidden h-14 w-14 rounded-full bg-primary/20 blur-xl md:block" aria-hidden="true"></div>
                                <figure class="overflow-hidden rounded-2xl border border-white/60 bg-white/80 shadow-xl backdrop-blur">
                                        <img src={image} alt={`${title} のイメージ`} class="h-64 w-full object-cover" loading="lazy" />
                                </figure>
                        </div>
                )}
        </div>
</section>
