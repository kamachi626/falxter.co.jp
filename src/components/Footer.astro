---
const yearRange = '2014-2025';
const footerLinks = [
	{ label: '会社概要', href: '/company' },
	{ label: 'プライバシーポリシー', href: '/privacy' },
	{ label: 'お問い合わせ', href: '/contact' }
];
---
<footer class="border-t border-gray-300/60 bg-gray-50">
	<div class="container-base py-10">
		<div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
			<div>
				<p class="text-lg font-semibold text-primary">FALXTER K.K.</p>
				<p class="mt-1 text-sm text-gray-700">小さなチームで柔軟に伴走するソフトウェア開発パートナー。</p>
			</div>
			<nav class="flex flex-wrap gap-3 text-sm font-semibold text-gray-800" aria-label="フッターナビゲーション">
				{footerLinks.map((link) => (
					<a href={link.href} class="hover:text-primary">
						{link.label}
					</a>
				))}
			</nav>
		</div>
		<p class="mt-6 text-xs text-gray-600">© {yearRange} FALXTER K.K. All rights reserved.</p>
	</div>
</footer>
