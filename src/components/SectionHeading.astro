---
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
}

const { title, description, eyebrow } = Astro.props;
---
<div class="space-y-3 text-center">
  {eyebrow && <p class="text-xs font-semibold uppercase tracking-wide text-brand">{eyebrow}</p>}
  <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl">{title}</h2>
  {description && <p class="mx-auto max-w-3xl text-base text-gray-700">{description}</p>}
</div>
