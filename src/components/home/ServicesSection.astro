---
import { services, systemSupportAudiences, systemSupportMethods } from "../../data/services";
import SystemSupportFlow from "./SystemSupportFlow.astro";

const webService = services.find((service) => service.slug === "corporate-website");
if (!webService) throw new Error("corporate-website service is not defined");
---
<section class="section surface" id="services">
  <div class="container">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">Services</p>
      <h2 class="heading">既存システムの調査・引き継ぎから、継続的な改善まで</h2>
      <p class="section-intro">状況が分からないシステムの整理を主軸に、必要な保守・改修、周辺機能や中小規模の新規開発まで一貫して対応します。コーポレートサイト制作もご相談いただけます。</p>
    </div>
    <SystemSupportFlow />
    <div class="service-grid" data-reveal>
      <article class="card service service-primary system-service">
        <div class="service-labels"><p class="service-number">01</p><span>既存システム支援</span><strong>まずはこちら</strong></div>
        <h3>既存システムの調査・引き継ぎ・保守・改修</h3>
        <p class="service-summary">仕様や管理状況が分からないシステムを調査し、必要な対応を整理します。</p>
        <dl class="service-meta">
          <div><dt>対象</dt><dd>業務システム、Webアプリケーション、クラウド環境</dd></div>


        </dl>
        <dl class="price-grid" aria-label="料金の目安">
          <div><dt>調査・引き継ぎ</dt><dd>50万円〜<small>（税別）</small></dd></div>
          <div><dt>スポット・新規開発</dt><dd>個別見積もり</dd></div>
          <div><dt>継続保守</dt><dd>月額30万円〜<small>（税別）</small></dd></div>
        </dl>
        <details class="service-scope system-scope">
          <summary>4つの対応方法と料金を見る</summary>
          <section class="system-audience"><h4>対象となるシステム</h4><ul>{systemSupportAudiences.map((item) => <li>{item}</li>)}</ul></section>
          <div class="method-grid">
            {systemSupportMethods.map((method) => (
              <section>
                <h4>{method.title}</h4>
                <p>{method.description}</p>
                <p class="method-price"><span>料金</span>{method.price}</p>
              </section>
            ))}
          </div>
        </details>
        <div class="service-links">
          <a href="/services/system-assessment/">調査・引き継ぎの詳細 <span aria-hidden="true">→</span></a>
          <a href="/services/system-maintenance/">保守・改修・新規開発の詳細 <span aria-hidden="true">→</span></a>
        </div>
      </article>

      <article class="card service service-secondary web-service">
        <div class="service-labels"><p class="service-number">02</p><span>Webサイト制作</span></div>
        <h3>{webService.title}</h3>
        <p class="service-summary">{webService.cardSummary}</p>
        <p class="included-summary">スマートフォン対応・問い合わせフォーム・基本SEO・公開作業込み</p>
        <dl class="service-meta">
          <div><dt>対象</dt><dd>{webService.cardAudience}</dd></div>
          <div><dt>期間</dt><dd>{webService.cardDuration}</dd></div>
          <div><dt>料金</dt><dd>{webService.price}</dd></div>
        </dl>
        <details class="service-scope">
          <summary>含まれる内容・条件を見る</summary>
          <dl>{webService.homeDetails.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}</dl>
        </details>
        <div class="service-links"><a href={`/services/${webService.slug}/`}>コーポレートサイト制作の詳細 <span aria-hidden="true">→</span></a></div>
      </article>
    </div>
  </div>
</section>
<style>
  .surface{background:#efebe5}.section-intro{max-width:56rem;margin:-.4rem 0 2rem;color:var(--color-body);font-size:1.0625rem;line-height:1.8}.service-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(20rem,.85fr);gap:1rem}.service{display:flex;min-width:0;flex-direction:column;border-top:4px solid var(--color-primary)}.service-secondary{border-top-color:#a79791;background:#fbfaf8}.service-labels{display:flex;min-height:1.6rem;align-items:center;gap:.65rem}.service-number{margin-right:auto!important;color:var(--color-primary);font:800 .8rem/1 system-ui;letter-spacing:.12em}.service-labels span{color:var(--color-muted);font-size:.75rem;font-weight:750;letter-spacing:.06em}.service-labels strong{padding:.25rem .5rem;background:var(--color-primary);color:#fff;font-size:.72rem;line-height:1.2}.service h3{margin:.9rem 0 .75rem;font-size:1.4rem;line-height:1.5}.service-summary{margin:0;line-height:1.85}.included-summary{margin:1rem 0 0!important;padding:.75rem;border-left:3px solid var(--color-primary);background:#fff;color:var(--color-text)!important;font-size:1rem!important;font-weight:750;line-height:1.7!important}.service-meta{margin:1.25rem 0 0;border-top:1px solid var(--color-border)}.price-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin:0 0 1.25rem;border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border)}.price-grid div{min-width:0;padding:.85rem .8rem;border-left:1px solid var(--color-border)}.price-grid div:first-child{border-left:0}.price-grid dt{margin-bottom:.25rem;line-height:1.5}.price-grid dd{color:var(--color-text);font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:1rem;font-weight:800;line-height:1.5}.price-grid small{display:block;color:var(--color-muted);font-family:inherit;font-size:.75rem;font-weight:650}.service-meta div,.service-scope dl div{display:grid;grid-template-columns:4.5rem minmax(0,1fr);gap:.7rem;padding:.7rem 0;border-bottom:1px solid var(--color-border)}dt{color:var(--color-primary);font-size:.875rem;font-weight:800}dd{margin:0;color:var(--color-body);font-size:1rem;line-height:1.7}.service-scope{margin-bottom:1.3rem}.service-scope summary{min-height:44px;padding:.65rem 0;color:var(--color-primary);font-weight:750;cursor:pointer}.service-scope dl{margin:.25rem 0 0}.system-audience{margin:.5rem 0 1rem;padding:1rem;border:1px solid var(--color-border);background:#fff}.system-audience h4{margin:0 0 .65rem;font-size:1.05rem}.system-audience ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.4rem 1rem;margin:0;padding-left:1.25rem}.system-audience li{color:var(--color-body);font-size:.95rem;line-height:1.65}.method-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin-top:.5rem}.method-grid section{padding:1rem;border:1px solid var(--color-border);background:#fff}.method-grid h4{margin:0 0 .45rem;font-size:1.05rem;line-height:1.5}.method-grid p{margin:0;color:var(--color-body);font-size:.95rem;line-height:1.7}.method-price{margin-top:.7rem!important;color:var(--color-text)!important;font-weight:750}.method-price span{display:block;color:var(--color-primary);font-size:.78rem}.service-links{display:flex;flex-wrap:wrap;gap:.65rem 1.25rem;margin-top:auto}.service-links a{display:inline-flex;min-height:44px;align-items:center;color:var(--color-primary);font-weight:750}@media(max-width:1100px){.service-grid{grid-template-columns:1fr}}@media(max-width:640px){.system-audience ul,.method-grid,.price-grid{grid-template-columns:1fr}.price-grid div,.price-grid div:first-child{border-top:1px solid var(--color-border);border-left:0}.price-grid div:first-child{border-top:0}}@media(max-width:480px){.service-meta div,.service-scope dl div{grid-template-columns:1fr;gap:.15rem}}
</style>