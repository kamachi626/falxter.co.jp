---
import { homeFaqs } from "../../data/home";
---
<section class="section faq-section" id="faq" aria-labelledby="faq-heading">
  <div class="faq-container">
    <p class="eyebrow">FAQ</p>
    <h2 class="heading" id="faq-heading">よくある質問</h2>
    <div class="faq-list">
      {homeFaqs.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .faq-section{padding-top:clamp(2.75rem,4.8vw,4.4rem);background:#fff}.faq-container{width:min(calc(100% - 2rem),60rem);margin-inline:auto}.faq-list{margin-top:2rem;border-bottom:1px solid var(--color-border)}details{border-top:1px solid var(--color-border)}summary{display:flex;min-height:56px;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 0;font-size:1.0625rem;font-weight:750;line-height:1.6;cursor:pointer}summary::after{content:"＋";flex:none;color:var(--color-primary);font-size:1.25rem}details[open] summary::after{content:"−"}details p{margin:0;padding:0 2.5rem 1.25rem 0;color:var(--color-body);font-size:1rem;line-height:1.8}
</style>