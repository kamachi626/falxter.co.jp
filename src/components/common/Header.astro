---
import { navigation, serviceNavigation } from "../../data/navigation";
import "../../styles/header.css";

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || (href !== "/" && pathname.startsWith(href));
const isServiceSection = pathname.startsWith("/services/");
const isServiceItemActive = (paths: string[]) => paths.includes(pathname);
const desktopServiceNavigation = serviceNavigation.filter((item) => item.href !== "/services/");
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="FALXTER トップ">
      <span class="brand-image">
        <img
          src="/images/logo.png?v=20260728"
          alt=""
          width="1000"
          height="250"
          fetchpriority="high"
          decoding="sync"
        />
      </span>
    </a>

    <nav aria-label="メインナビゲーション" class="desktop">
      <div class:list={["desktop-service-nav", { active: isServiceSection }]}>
        <a
          class="service-trigger"
          href="/services/"
          aria-current={isServiceSection ? "page" : undefined}
        >
          サービス<span aria-hidden="true"></span>
        </a>
        <div class="service-submenu" role="group" aria-label="サービスメニュー">
          {
            desktopServiceNavigation.map((item) => (
              <a
                class:list={{ active: isServiceItemActive(item.paths) }}
                href={item.href}
                aria-current={isServiceItemActive(item.paths) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>
      {
        navigation.map((item) => (
          <a
            class:list={{ active: isActive(item.href) }}
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a
        class:list={["contact", { active: isActive("/contact/") }]}
        href="/contact/"
        aria-current={isActive("/contact/") ? "page" : undefined}
      >
        お問い合わせ
      </a>
    </nav>

    <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu">
      <span>メニュー</span>
    </button>
  </div>

</header>

<button class="mobile-menu-backdrop" type="button" aria-label="メニューを閉じる" hidden></button>

<div id="mobile-menu" class="mobile-menu" role="dialog" aria-modal="true" aria-label="モバイルメニュー" hidden>
    <nav aria-label="モバイルナビゲーション">
      <details class:list={["mobile-service-nav", { active: isServiceSection }]}>
        <summary>サービス</summary>
        <div class="mobile-service-submenu" role="group" aria-label="サービスメニュー">
          {
            serviceNavigation.map((item) => (
              <a
                class:list={{ active: isServiceItemActive(item.paths) }}
                href={item.href}
                aria-current={isServiceItemActive(item.paths) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </details>
      {
        navigation.map((item) => (
          <a
            class:list={{ active: isActive(item.href) }}
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a
        class:list={{ active: isActive("/contact/") }}
        href="/contact/"
        aria-current={isActive("/contact/") ? "page" : undefined}
      >
        お問い合わせ
      </a>
    </nav>
  </div>

<noscript>
  <div class="noscript container">
    <a href="/services/">サービス</a> · <a href="/company/">会社情報</a> ·
    <a href="/contact/">お問い合わせ</a>
  </div>
</noscript>

<script is:inline>
  (() => {
    const header = document.querySelector(".site-header");
    const button = document.querySelector(".menu-button");
    const mobileMenu = document.querySelector("#mobile-menu");
    const mobileBackdrop = document.querySelector(".mobile-menu-backdrop");
    const desktopService = document.querySelector(".desktop-service-nav");
    const mobileService = document.querySelector(".mobile-service-nav");
    if (
      !(button instanceof HTMLElement) ||
      !(mobileMenu instanceof HTMLElement) ||
      !(mobileBackdrop instanceof HTMLElement)
    )
      return;

    let previous;
    const mobileFocusable = () =>
      [button, ...mobileMenu.querySelectorAll("summary, a")].filter(
        (element) => element instanceof HTMLElement && element.offsetParent !== null,
      );
    const closeMobile = () => {
      mobileMenu.hidden = true;
      mobileBackdrop.hidden = true;
      header?.classList.remove("menu-open");
      button.setAttribute("aria-expanded", "false");
      if (mobileService instanceof HTMLDetailsElement) mobileService.open = false;
      previous?.focus();
    };

    button.addEventListener("click", () => {
      const open = button.getAttribute("aria-expanded") === "true";
      if (open) {
        closeMobile();
        return;
      }
      previous = document.activeElement instanceof HTMLElement ? document.activeElement : undefined;
      header?.classList.add("menu-open");
      mobileBackdrop.hidden = false;
      mobileMenu.hidden = false;
      button.setAttribute("aria-expanded", "true");
    });

    if (desktopService instanceof HTMLElement) {
      const restoreDesktopPopup = () => desktopService.classList.remove("dismissed");
      desktopService.addEventListener("mouseenter", restoreDesktopPopup);
      desktopService.addEventListener("mouseleave", restoreDesktopPopup);
      desktopService.addEventListener("focusin", restoreDesktopPopup);
    }

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        if (
          desktopService instanceof HTMLElement &&
          (desktopService.matches(":hover") || desktopService.contains(document.activeElement))
        ) {
          desktopService.querySelector(".service-trigger")?.focus();
          desktopService.classList.add("dismissed");
        }
        if (!mobileMenu.hidden) closeMobile();
      }
      if (event.key === "Tab" && !mobileMenu.hidden) {
        const focusable = mobileFocusable();
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last?.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first?.focus();
        }
      }
    });

    mobileBackdrop.addEventListener("click", closeMobile);

    mobileMenu.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) closeMobile();
    });
  })();
</script>
