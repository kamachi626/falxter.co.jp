{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@styles/*": ["src/styles/*"],
      "@content/*": ["src/content/*"],
      "@config": ["src/site.config"],
      "@layouts/*": ["src/layouts/*"]
    }
  },
  "include": ["src/**/*", "astro.config.mjs", "tailwind.config.cjs", "package.json"]
}
